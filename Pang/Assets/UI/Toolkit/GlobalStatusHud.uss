.global-status-hud {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.left-hud {
	position: absolute;
	left: 12px;
	bottom: 12px;
	width: 235px;
}

.scenario-objective {
	margin-bottom: 6px;
	padding: 8px;
	background-color: rgba(12, 20, 29, 0.95);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 3px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgb(82, 181, 211);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.scenario-objective__eyebrow {
	margin-bottom: 2px;
	font-size: 9px;
	-unity-font-style: bold;
	letter-spacing: 1.2px;
	color: rgb(104, 181, 207);
}

.scenario-objective__title {
	font-size: 12px;
	-unity-font-style: bold;
	color: rgb(231, 240, 243);
}

.scenario-objective__description {
	margin-top: 2px;
	white-space: normal;
	font-size: 11px;
	color: rgb(180, 200, 209);
}

.scenario-objective__progress {
	margin-top: 4px;
	font-size: 11px;
	-unity-font-style: bold;
	color: rgb(102, 220, 177);
}

.logistics-work-hud {
	margin-bottom: 6px;
	overflow: hidden;
	background-color: rgba(12, 20, 29, 0.95);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.logistics-work-hud--hidden {
	display: none;
}

.logistics-work-hud__header {
	height: 27px;
	min-height: 27px;
	margin: 0;
	padding-top: 0;
	padding-right: 5px;
	padding-bottom: 0;
	padding-left: 7px;
	flex-direction: row;
	align-items: center;
	background-color: rgba(19, 33, 44, 0.98);
	border-top-width: 0;
	border-right-width: 0;
	border-bottom-width: 1px;
	border-left-width: 0;
	border-bottom-color: rgba(73, 126, 153, 0.45);
	border-top-left-radius: 0;
	border-top-right-radius: 0;
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
}

.logistics-work-hud__header:hover {
	background-color: rgba(31, 54, 67, 0.98);
}

.logistics-work-hud__eyebrow {
	font-size: 8px;
	-unity-font-style: bold;
	letter-spacing: 0.8px;
	color: rgb(104, 181, 207);
}

.logistics-work-hud__header-spacer {
	flex-grow: 1;
}

.logistics-work-hud__total {
	margin-left: 4px;
	font-size: 7px;
	-unity-font-style: bold;
	color: rgb(151, 177, 188);
	white-space: nowrap;
}

.logistics-work-hud__total--blocked {
	color: rgb(246, 126, 113);
}

.logistics-work-hud__chevron {
	width: 8px;
	margin-left: 2px;
	font-size: 12px;
	-unity-font-style: bold;
	-unity-text-align: middle-right;
	color: rgb(100, 183, 207);
}

.logistics-work-hud__body {
	padding-top: 3px;
	padding-right: 4px;
	padding-bottom: 4px;
	padding-left: 4px;
}

.logistics-work-hud__columns,
.logistics-work-hud__row {
	height: 18px;
	min-height: 18px;
	flex-direction: row;
	align-items: center;
}

.logistics-work-hud__columns {
	height: 14px;
	min-height: 14px;
	border-bottom-width: 1px;
	border-bottom-color: rgba(58, 92, 108, 0.42);
}

.logistics-work-hud__row {
	border-left-width: 2px;
	border-left-color: rgba(73, 156, 181, 0.45);
}

.logistics-work-hud__row--unserved {
	border-left-color: rgb(225, 166, 92);
	background-color: rgba(70, 47, 20, 0.38);
}

.logistics-work-hud__row--blocked {
	border-left-color: rgb(224, 82, 82);
	background-color: rgba(78, 29, 31, 0.52);
}

.logistics-work-hud__name {
	width: 64px;
	min-width: 64px;
	padding-left: 5px;
	font-size: 8px;
	color: rgb(185, 205, 214);
	white-space: nowrap;
}

.logistics-work-hud__value {
	width: 32px;
	min-width: 32px;
	font-size: 9px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
	color: rgb(219, 232, 237);
	white-space: nowrap;
}

.logistics-work-hud__column {
	font-size: 7px;
	letter-spacing: 0.3px;
	color: rgb(102, 137, 151);
}

.logistics-work-hud__blocked-value {
	color: rgb(225, 166, 92);
}

.logistics-work-hud__row--blocked .logistics-work-hud__blocked-value {
	color: rgb(246, 126, 113);
}

.order-hud {
	position: absolute;
	left: 12px;
	top: 12px;
	width: 235px;
	margin-bottom: 0;
	overflow: hidden;
	background-color: rgba(12, 20, 29, 0.96);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.order-hud--hidden {
	display: none;
}

.order-hud__header {
	height: 27px;
	min-height: 27px;
	margin: 0;
	padding-top: 0;
	padding-right: 6px;
	padding-bottom: 0;
	padding-left: 7px;
	flex-direction: row;
	align-items: center;
	background-color: rgba(19, 33, 44, 0.98);
	border-top-width: 0;
	border-right-width: 0;
	border-bottom-width: 1px;
	border-left-width: 0;
	border-bottom-color: rgba(73, 126, 153, 0.45);
	border-top-left-radius: 0;
	border-top-right-radius: 0;
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
}

.order-hud__header:hover {
	background-color: rgba(31, 54, 67, 0.98);
}

.order-hud__eyebrow {
	font-size: 8px;
	-unity-font-style: bold;
	letter-spacing: 1.1px;
	color: rgb(104, 181, 207);
}

.order-hud__header-spacer {
	flex-grow: 1;
}

.order-hud__count {
	margin-left: 4px;
	font-size: 7px;
	-unity-font-style: bold;
	color: rgb(180, 200, 209);
}

.order-hud__risk-count {
	margin-left: 5px;
	padding-left: 4px;
	padding-right: 4px;
	font-size: 7px;
	-unity-font-style: bold;
	color: rgb(221, 180, 93);
	background-color: rgba(89, 62, 23, 0.62);
	border-top-left-radius: 3px;
	border-top-right-radius: 3px;
	border-bottom-left-radius: 3px;
	border-bottom-right-radius: 3px;
}

.order-hud__risk-count--danger {
	color: rgb(255, 170, 156);
	background-color: rgba(103, 39, 34, 0.72);
}

.order-hud__chevron {
	width: 9px;
	margin-left: 3px;
	font-size: 13px;
	-unity-font-style: bold;
	-unity-text-align: middle-right;
	color: rgb(100, 183, 207);
}

.order-hud__body {
	padding-top: 4px;
	padding-right: 4px;
	padding-bottom: 4px;
	padding-left: 4px;
	flex-direction: column;
}

.order-hud__order {
	margin: 0;
	background-color: rgba(22, 37, 48, 0.94);
	border-top-width: 0;
	border-right-width: 0;
	border-bottom-width: 0;
	border-left-width: 3px;
	border-left-color: rgb(73, 156, 181);
	border-top-left-radius: 2px;
	border-top-right-radius: 2px;
	border-bottom-left-radius: 2px;
	border-bottom-right-radius: 2px;
}

.order-hud__order:hover {
	background-color: rgba(34, 57, 69, 0.98);
}

.order-hud__primary {
	min-height: 91px;
	padding-top: 5px;
	padding-right: 6px;
	padding-bottom: 4px;
	padding-left: 6px;
	flex-direction: column;
	align-items: stretch;
}

.order-hud__primary-heading {
	height: 17px;
	flex-direction: row;
	align-items: center;
}

.order-hud__order-id {
	font-size: 10px;
	-unity-font-style: bold;
	color: rgb(231, 240, 243);
}

.order-hud__destination {
	margin-left: 6px;
	font-size: 7px;
	-unity-font-style: bold;
	letter-spacing: 0.6px;
	color: rgb(105, 188, 213);
}

.order-hud__due {
	font-size: 8px;
	-unity-font-style: bold;
	-unity-text-align: middle-right;
	color: rgb(148, 203, 217);
	white-space: nowrap;
}

.order-hud__item {
	height: 15px;
	margin-top: 1px;
	font-size: 8px;
	color: rgb(184, 204, 212);
	white-space: nowrap;
}

.order-hud__stages {
	height: 31px;
	margin-top: 3px;
	flex-direction: row;
	background-color: rgba(8, 17, 24, 0.72);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(58, 92, 108, 0.45);
	border-right-color: rgba(58, 92, 108, 0.45);
	border-bottom-color: rgba(58, 92, 108, 0.45);
	border-left-color: rgba(58, 92, 108, 0.45);
}

.order-hud__stage {
	min-width: 0;
	flex-grow: 1;
	align-items: center;
	justify-content: center;
	border-right-width: 1px;
	border-right-color: rgba(58, 92, 108, 0.36);
}

.order-hud__stage--last {
	border-right-width: 0;
}

.order-hud__stage-label {
	font-size: 5px;
	-unity-font-style: bold;
	letter-spacing: 0.3px;
	color: rgb(104, 137, 151);
}

.order-hud__stage-value {
	margin-top: 1px;
	font-size: 9px;
	-unity-font-style: bold;
	color: rgb(209, 226, 233);
}

.order-hud__risk {
	height: 15px;
	margin-top: 3px;
	font-size: 7px;
	color: rgb(117, 191, 164);
	white-space: nowrap;
}

.order-hud__risk--warning {
	color: rgb(226, 174, 72);
}

.order-hud__risk--danger {
	color: rgb(238, 125, 111);
}

.order-hud__secondary {
	height: 25px;
	min-height: 25px;
	margin-top: 3px;
	padding-top: 0;
	padding-right: 6px;
	padding-bottom: 0;
	padding-left: 6px;
	flex-direction: row;
	align-items: center;
}

.order-hud__secondary-id {
	width: 32px;
	font-size: 8px;
	-unity-font-style: bold;
	color: rgb(220, 233, 238);
}

.order-hud__secondary-destination {
	width: 34px;
	font-size: 6px;
	-unity-font-style: bold;
	color: rgb(105, 188, 213);
}

.order-hud__secondary-item {
	min-width: 0;
	flex-grow: 1;
	font-size: 7px;
	color: rgb(159, 184, 194);
	white-space: nowrap;
}

.order-hud__secondary .order-hud__due {
	width: 38px;
}

.order-hud__more {
	height: 20px;
	min-height: 20px;
	margin-top: 3px;
	margin-right: 0;
	margin-bottom: 0;
	margin-left: 0;
	padding: 0;
	font-size: 7px;
	-unity-font-style: bold;
	color: rgb(113, 177, 196);
	background-color: rgba(18, 31, 41, 0.86);
	border-top-width: 0;
	border-right-width: 0;
	border-bottom-width: 0;
	border-left-width: 0;
}

.order-hud__more:hover {
	color: rgb(218, 239, 245);
	background-color: rgba(34, 57, 69, 0.96);
}

.order-hud__empty {
	display: none;
	height: 28px;
	font-size: 8px;
	color: rgb(119, 145, 157);
	-unity-text-align: middle-center;
}

.order-hud__order--due-soon {
	border-left-color: rgb(212, 168, 74);
}

.order-hud__order--due-soon .order-hud__due {
	color: rgb(227, 188, 102);
}

.order-hud__order--due-this-week {
	border-left-color: rgb(229, 126, 56);
	background-color: rgba(57, 39, 24, 0.94);
}

.order-hud__order--due-this-week .order-hud__due {
	color: rgb(244, 154, 83);
}

.order-hud__order--delayed {
	border-left-color: rgb(218, 76, 69);
	background-color: rgba(61, 31, 33, 0.95);
}

.order-hud__order--delayed .order-hud__due {
	color: rgb(246, 126, 113);
}

.hud-event-area {
	min-height: 0;
	margin-bottom: 5px;
}

.hud-event-list {
	flex-direction: column;
	justify-content: flex-end;
}

.hud-event-entry {
	height: 23px;
	flex-direction: row;
	align-items: center;
	margin-top: 3px;
	background-color: rgba(12, 20, 29, 0.92);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(68, 100, 117, 0.65);
	border-right-color: rgba(68, 100, 117, 0.65);
	border-bottom-color: rgba(68, 100, 117, 0.65);
	border-left-color: rgba(68, 100, 117, 0.65);
}

.hud-event-entry__indicator {
	width: 3px;
	height: 21px;
	background-color: rgb(123, 169, 191);
}

.hud-event-entry__message {
	flex-grow: 1;
	padding-left: 6px;
	padding-right: 6px;
	font-size: 11px;
	color: rgb(222, 233, 238);
}

.hud-event-entry--money .hud-event-entry__indicator {
	background-color: rgb(92, 211, 166);
}

.hud-event-entry--reputation .hud-event-entry__indicator {
	background-color: rgb(90, 177, 222);
}

.hud-event-entry--warning .hud-event-entry__indicator {
	background-color: rgb(226, 174, 72);
}

.hud-event-entry--error .hud-event-entry__indicator {
	background-color: rgb(224, 82, 82);
}

.economy-summary {
	height: 42px;
	flex-direction: row;
	align-items: center;
	padding-left: 8px;
	padding-right: 7px;
	overflow: hidden;
	background-color: rgba(12, 20, 29, 0.95);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-left-radius: 5px;
	border-bottom-right-radius: 5px;
}

.economy-summary:hover {
	background-color: rgba(22, 38, 50, 0.97);
	border-top-color: rgb(70, 169, 198);
	border-right-color: rgb(70, 169, 198);
	border-bottom-color: rgb(70, 169, 198);
	border-left-color: rgb(70, 169, 198);
}

.status-item {
	width: 82px;
	overflow: hidden;
}

.status-label {
	margin-bottom: 1px;
	font-size: 9px;
	-unity-font-style: bold;
	letter-spacing: 1.2px;
	color: rgb(126, 153, 166);
}

.status-value {
	font-size: 13px;
	-unity-font-style: bold;
	color: rgb(231, 240, 243);
}

.status-value--money {
	color: rgb(102, 220, 177);
}

.status-value--reputation {
	color: rgb(112, 191, 231);
}

.status-divider {
	width: 1px;
	height: 22px;
	margin-left: 3px;
	margin-right: 7px;
	background-color: rgba(93, 127, 143, 0.4);
}

.history-hint {
	display: none;
}

.time-cluster {
	position: absolute;
	left: 50%;
	bottom: 12px;
	translate: -50% 0;
	width: 405px;
	height: 63px;
	flex-direction: row;
	align-items: center;
	padding-left: 12px;
	padding-right: 9px;
	background-color: rgba(12, 20, 29, 0.95);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-left-radius: 5px;
	border-bottom-right-radius: 5px;
}

.date-block {
	width: 158px;
}

.date-block .status-label {
	font-size: 10px;
	letter-spacing: 1.8px;
}

.date-value {
	font-size: 15px;
	-unity-font-style: bold;
	color: rgb(224, 235, 240);
}

.time-divider {
	width: 1px;
	height: 33px;
	margin-left: 9px;
	margin-right: 8px;
	background-color: rgba(93, 127, 143, 0.4);
}

.speed-button {
	width: 38px;
	height: 35px;
	margin-left: 3px;
	padding: 0;
	font-size: 15px;
	color: rgb(191, 211, 220);
	background-color: rgb(30, 47, 61);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgb(58, 89, 105);
	border-right-color: rgb(58, 89, 105);
	border-bottom-color: rgb(58, 89, 105);
	border-left-color: rgb(58, 89, 105);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.speed-button:hover {
	color: rgb(238, 248, 251);
	background-color: rgb(43, 75, 91);
	border-top-color: rgb(77, 173, 200);
	border-right-color: rgb(77, 173, 200);
	border-bottom-color: rgb(77, 173, 200);
	border-left-color: rgb(77, 173, 200);
}

.speed-button:active {
	background-color: rgb(27, 111, 136);
}

.speed-button:disabled {
	opacity: 0.35;
}

.speed-value {
	min-width: 54px;
	margin-left: 6px;
	font-size: 15px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
	color: rgb(95, 206, 229);
}

.management-cluster {
	position: absolute;
	top: 12px;
	right: 12px;
	width: 128px;
}

.management-button {
	width: 128px;
	height: 30px;
	padding: 0;
	font-size: 10px;
	-unity-font-style: bold;
	color: rgb(211, 227, 234);
	background-color: rgba(12, 20, 29, 0.95);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.management-button:hover,
.management-button--open {
	color: rgb(238, 248, 251);
	background-color: rgb(31, 54, 67);
	border-top-color: rgb(77, 173, 200);
	border-right-color: rgb(77, 173, 200);
	border-bottom-color: rgb(77, 173, 200);
	border-left-color: rgb(77, 173, 200);
}

.management-menu {
	display: none;
	margin-top: 4px;
	padding-top: 3px;
	padding-right: 3px;
	padding-bottom: 3px;
	padding-left: 3px;
	background-color: rgba(12, 20, 29, 0.97);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.management-menu__button {
	height: 26px;
	margin-top: 1px;
	margin-bottom: 1px;
	padding-left: 9px;
	font-size: 11px;
	-unity-font-style: bold;
	-unity-text-align: middle-left;
	color: rgb(191, 211, 220);
	background-color: rgba(25, 39, 50, 0.94);
	border-top-width: 0;
	border-right-width: 0;
	border-bottom-width: 0;
	border-left-width: 2px;
	border-left-color: rgba(73, 126, 153, 0.45);
}

.management-menu__button:hover {
	color: rgb(238, 248, 251);
	background-color: rgb(38, 65, 78);
	border-left-color: rgb(77, 173, 200);
}

.management-menu__button:active {
	background-color: rgb(27, 111, 136);
}

.management-menu__button--locked,
.management-menu__button--locked:hover,
.management-menu__button--locked:active {
	color: rgb(105, 120, 128);
	background-color: rgba(24, 32, 38, 0.94);
	border-left-color: rgb(82, 89, 93);
}

.selection-card {
	display: none;
	position: absolute;
	right: 12px;
	bottom: 12px;
	width: 270px;
	height: 150px;
	padding-top: 10px;
	padding-right: 10px;
	padding-bottom: 8px;
	padding-left: 12px;
	overflow: hidden;
	opacity: 1;
	translate: 0 0;
	scale: 1 1;
	transform-origin: 100% 100%;
	transition-property: opacity, translate, scale, height;
	transition-duration: 0.18s;
	transition-timing-function: ease-out;
	background-color: rgba(12, 20, 29, 0.96);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.7);
	border-right-color: rgba(73, 126, 153, 0.7);
	border-bottom-color: rgba(73, 126, 153, 0.7);
	border-left-color: rgba(73, 126, 153, 0.7);
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-left-radius: 5px;
	border-bottom-right-radius: 5px;
}

.selection-card--reset { transition-duration: 0s; }
.selection-card--enter { opacity: 0; translate: 30px 18px; scale: 0.88 0.88; }
.selection-card__accent { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background-color: rgb(74, 186, 218); }
.selection-card__header { min-height: 35px; flex-direction: row; align-items: center; }
.selection-card__icon { width: 32px; height: 32px; margin-right: 9px; -unity-background-scale-mode: scale-to-fit; }
.selection-card__identity { flex-grow: 1; overflow: hidden; }
.selection-card__title { font-size: 12px; -unity-font-style: bold; color: rgb(231, 240, 243); white-space: nowrap; }
.selection-card__subtitle { margin-top: 2px; font-size: 10px; -unity-font-style: bold; letter-spacing: 0.8px; color: rgb(103, 196, 220); white-space: nowrap; }
.selection-card__divider { height: 1px; margin-top: 7px; margin-bottom: 5px; background-color: rgba(93, 127, 143, 0.38); }
.selection-card__info-list { min-height: 44px; }
.selection-card-info-row { height: 20px; flex-direction: row; align-items: center; }
.selection-card-info-row__key { flex-grow: 1; font-size: 10px; color: rgb(126, 153, 166); }
.selection-card-info-row__value { max-width: 145px; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-right; color: rgb(218, 231, 236); white-space: nowrap; }
.selection-card__actions { height: 29px; flex-direction: row; justify-content: flex-end; align-items: flex-end; margin-top: 5px; }
.selection-card__button { width: 68px; height: 24px; margin-left: 4px; padding: 0; font-size: 10px; -unity-font-style: bold; color: rgb(191, 211, 220); background-color: rgb(30, 47, 61); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(58, 89, 105); border-right-color: rgb(58, 89, 105); border-bottom-color: rgb(58, 89, 105); border-left-color: rgb(58, 89, 105); }
.selection-card__button:hover { color: rgb(238, 248, 251); background-color: rgb(43, 75, 91); border-top-color: rgb(77, 173, 200); border-right-color: rgb(77, 173, 200); border-bottom-color: rgb(77, 173, 200); border-left-color: rgb(77, 173, 200); }
.selection-card__button--primary { color: rgb(225, 239, 244); background-color: rgb(31, 89, 108); border-top-color: rgb(65, 151, 177); border-right-color: rgb(65, 151, 177); border-bottom-color: rgb(65, 151, 177); border-left-color: rgb(65, 151, 177); }
.selection-card__inspector { display: flex; height: 0; margin-top: 0; padding-top: 0; overflow: hidden; opacity: 0; translate: 0 10px; transition-property: height, opacity, translate, margin-top, padding-top; transition-duration: 0.12s; transition-timing-function: ease-out; border-top-width: 0; border-top-color: rgba(93, 127, 143, 0.38); }
.selection-card__detail-tabs { display: none; height: 25px; flex-direction: row; margin-bottom: 5px; }
.selection-card__section-title { height: 18px; font-size: 9px; -unity-font-style: bold; letter-spacing: 0.9px; color: rgb(103, 196, 220); -unity-text-align: middle-left; }
.selection-card__section-title--actions { margin-top: 5px; }
.selection-card__overview-list { min-height: 60px; }
.selection-card__context-actions { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; min-height: 25px; }
.selection-card__context-button-control { height: 24px; min-width: 82px; margin-left: 4px; margin-bottom: 4px; }
.selection-card__context-button-control .selection-card__context-button { height: 24px; min-width: 82px; margin-left: 0; margin-bottom: 0; }
.selection-card__context-button { height: 24px; min-width: 82px; margin-left: 4px; margin-bottom: 4px; padding-left: 8px; padding-right: 8px; font-size: 10px; -unity-font-style: bold; color: rgb(208, 224, 230); background-color: rgb(30, 47, 61); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(58, 89, 105); border-right-color: rgb(58, 89, 105); border-bottom-color: rgb(58, 89, 105); border-left-color: rgb(58, 89, 105); }
.selection-card__context-button:hover { background-color: rgb(43, 75, 91); border-top-color: rgb(77, 173, 200); border-right-color: rgb(77, 173, 200); border-bottom-color: rgb(77, 173, 200); border-left-color: rgb(77, 173, 200); }
.selection-card__context-button--danger { color: rgb(238, 177, 164); background-color: rgb(71, 39, 39); border-top-color: rgb(122, 63, 58); border-right-color: rgb(122, 63, 58); border-bottom-color: rgb(122, 63, 58); border-left-color: rgb(122, 63, 58); }
.selection-card--expanded { height: 280px; }
.selection-card--expanded .selection-card__info-list { display: none; }
.selection-card--expanded .selection-card__inspector { height: 170px; margin-top: 4px; padding-top: 3px; opacity: 1; translate: 0 0; border-top-width: 1px; }

.selection-card__detail-tabs--visible { display: flex; }
.selection-card__detail-tab { height: 24px; min-width: 0; flex-grow: 1; margin-right: 4px; padding-left: 5px; padding-right: 5px; font-size: 10px; -unity-font-style: bold; color: rgb(151, 177, 188); background-color: rgba(25, 39, 50, 0.92); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(50, 76, 89); border-right-color: rgb(50, 76, 89); border-bottom-color: rgb(50, 76, 89); border-left-color: rgb(50, 76, 89); }
.selection-card__detail-tab:hover { color: rgb(235, 246, 249); border-top-color: rgb(77, 173, 200); border-right-color: rgb(77, 173, 200); border-bottom-color: rgb(77, 173, 200); border-left-color: rgb(77, 173, 200); }
.selection-card__detail-tab--active { color: rgb(235, 246, 249); background-color: rgb(31, 89, 108); border-top-color: rgb(65, 151, 177); border-right-color: rgb(65, 151, 177); border-bottom-color: rgb(65, 151, 177); border-left-color: rgb(65, 151, 177); }

.selection-detail-panel { position: absolute; right: 282px; bottom: 12px; width: 0; height: 280px; padding-top: 10px; padding-right: 0; padding-bottom: 9px; padding-left: 0; overflow: hidden; opacity: 0; translate: 18px 0; transition-property: width, height, opacity, translate, padding-right, padding-left; transition-duration: 0.18s; transition-timing-function: ease-out; background-color: rgba(10, 18, 27, 0.97); border-top-width: 1px; border-right-width: 0; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgba(73, 126, 153, 0.7); border-bottom-color: rgba(73, 126, 153, 0.7); border-left-color: rgba(73, 126, 153, 0.7); border-top-left-radius: 5px; border-bottom-left-radius: 5px; }
.selection-detail-panel--open { width: 340px; padding-right: 11px; padding-left: 11px; opacity: 1; translate: 0 0; }
.selection-detail-panel__header { height: 38px; border-bottom-width: 1px; border-bottom-color: rgba(93, 127, 143, 0.38); }
.selection-detail-panel__title { height: 18px; font-size: 10px; -unity-font-style: bold; letter-spacing: 0.8px; color: rgb(225, 239, 244); }
.selection-detail-panel__summary { height: 15px; font-size: 10px; color: rgb(126, 153, 166); }
.selection-detail-panel__slider-control { display: none; height: 47px; margin-top: 6px; padding-top: 4px; padding-right: 6px; padding-left: 6px; background-color: rgba(25, 39, 50, 0.72); }
.selection-detail-panel__slider-header { height: 16px; flex-direction: row; }
.selection-detail-panel__slider-label { flex-grow: 1; font-size: 10px; color: rgb(151, 177, 188); }
.selection-detail-panel__slider-value { font-size: 10px; -unity-font-style: bold; color: rgb(103, 196, 220); -unity-text-align: middle-right; }
.selection-detail-panel__slider { height: 20px; margin-top: 2px; }
.selection-detail-panel__toggle-control { display: none; min-height: 48px; margin-top: 6px; padding-top: 5px; padding-right: 7px; padding-bottom: 5px; padding-left: 7px; background-color: rgba(25, 39, 50, 0.72); }
.selection-detail-panel__toggle { height: 20px; font-size: 11px; -unity-font-style: bold; color: rgb(209, 226, 233); }
.selection-detail-panel__toggle-description { min-height: 17px; margin-top: 2px; font-size: 10px; color: rgb(126, 153, 166); white-space: normal; }
.selection-detail-editor { display: none; min-height: 210px; margin-top: 6px; padding-top: 7px; padding-right: 7px; padding-bottom: 7px; padding-left: 7px; background-color: rgba(25, 39, 50, 0.72); }
.selection-detail-editor__message { min-height: 16px; margin-bottom: 5px; font-size: 10px; color: rgb(199, 174, 108); white-space: normal; }
.selection-detail-editor__label { height: 15px; margin-top: 2px; font-size: 10px; -unity-font-style: bold; color: rgb(151, 177, 188); }
.selection-detail-editor__dropdown { height: 25px; margin-bottom: 5px; font-size: 11px; }
.selection-detail-editor__toggles { height: 82px; margin-top: 2px; margin-bottom: 5px; }
.selection-detail-editor__toggle { height: 22px; font-size: 11px; color: rgb(209, 226, 233); }
.selection-detail-editor__actions { height: 26px; flex-direction: row; justify-content: flex-end; }
.selection-detail-editor__button { min-width: 92px; height: 24px; margin-left: 5px; font-size: 10px; color: rgb(199, 218, 227); background-color: rgba(42, 60, 71, 0.95); }
.selection-detail-editor__button--primary { color: rgb(230, 245, 250); background-color: rgba(34, 105, 128, 0.95); }
.selection-detail-panel__list { flex-grow: 1; margin-top: 6px; background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; }
.selection-detail-panel__empty { display: none; flex-grow: 1; font-size: 11px; color: rgb(112, 137, 149); -unity-text-align: middle-center; }
.selection-detail-row { height: 42px; padding-top: 4px; padding-right: 7px; padding-bottom: 4px; padding-left: 7px; margin-bottom: 2px; background-color: rgba(25, 39, 50, 0.72); border-left-width: 2px; border-left-color: rgba(73, 126, 153, 0.45); }
.selection-detail-row--slot { background-color: rgba(27, 44, 56, 0.86); border-left-color: rgba(79, 151, 179, 0.82); }
.selection-detail-row--empty-slot { background-color: rgba(20, 32, 42, 0.72); border-left-color: rgba(73, 126, 153, 0.38); }
.selection-detail-row__content { height: 34px; flex-direction: row; align-items: center; }
.selection-detail-row__thumbnail-control { display: none; width: 34px; height: 34px; min-width: 34px; margin-right: 7px; background-color: rgba(11, 21, 29, 0.9); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgba(74, 124, 146, 0.72); border-right-color: rgba(74, 124, 146, 0.72); border-bottom-color: rgba(74, 124, 146, 0.72); border-left-color: rgba(74, 124, 146, 0.72); }
.selection-detail-row__thumbnail { width: 32px; height: 32px; flex-shrink: 0; }
.selection-detail-row__thumbnail-action { display: none; position: absolute; left: 0; top: 0; width: 32px; height: 32px; margin: 0; padding: 0; font-size: 20px; -unity-font-style: bold; color: rgb(118, 198, 220); background-color: rgba(24, 48, 62, 0.92); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; }
.selection-detail-row__thumbnail-action:hover { color: rgb(235, 249, 252); background-color: rgba(39, 88, 108, 0.96); }
.selection-detail-row__thumbnail-action:disabled { opacity: 0.42; }
.selection-detail-row__text { min-width: 0; flex-grow: 1; }
.selection-detail-row__top { height: 17px; flex-direction: row; align-items: center; }
.selection-detail-row__primary { flex-grow: 1; font-size: 11px; -unity-font-style: bold; color: rgb(218, 231, 236); white-space: nowrap; }
.selection-detail-row__trailing { font-size: 11px; -unity-font-style: bold; color: rgb(103, 196, 220); -unity-text-align: middle-right; white-space: nowrap; }
.selection-detail-row__action-control { display: none; width: 56px; height: 18px; margin-left: 6px; }
.selection-detail-row__action { width: 56px; height: 18px; margin: 0; padding-top: 0; padding-right: 5px; padding-bottom: 0; padding-left: 5px; font-size: 9px; -unity-font-style: bold; color: rgb(225, 239, 244); background-color: rgb(31, 89, 108); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(65, 151, 177); border-right-color: rgb(65, 151, 177); border-bottom-color: rgb(65, 151, 177); border-left-color: rgb(65, 151, 177); }
.selection-detail-row__action:hover { color: rgb(238, 248, 251); background-color: rgb(43, 112, 135); border-top-color: rgb(77, 173, 200); border-right-color: rgb(77, 173, 200); border-bottom-color: rgb(77, 173, 200); border-left-color: rgb(77, 173, 200); }
.selection-detail-row__action:disabled { opacity: 0.48; }
.selection-detail-row__action--danger { color: rgb(238, 177, 164); background-color: rgb(71, 39, 39); border-top-color: rgb(122, 63, 58); border-right-color: rgb(122, 63, 58); border-bottom-color: rgb(122, 63, 58); border-left-color: rgb(122, 63, 58); }
.selection-detail-row__action--danger:hover { color: rgb(255, 210, 200); background-color: rgb(94, 47, 45); border-top-color: rgb(156, 76, 69); border-right-color: rgb(156, 76, 69); border-bottom-color: rgb(156, 76, 69); border-left-color: rgb(156, 76, 69); }
.selection-detail-row__secondary { height: 15px; margin-top: 2px; font-size: 10px; color: rgb(139, 163, 174); white-space: nowrap; }
