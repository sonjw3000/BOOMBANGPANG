.global-status-hud {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.left-hud {
	position: absolute;
	left: 12px;
	bottom: 12px;
	width: 235px;
}

.hud-event-area {
	min-height: 0;
	margin-bottom: 5px;
}

.hud-event-list {
	flex-direction: column;
	justify-content: flex-end;
}

.hud-event-entry {
	height: 23px;
	flex-direction: row;
	align-items: center;
	margin-top: 3px;
	background-color: rgba(12, 20, 29, 0.92);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(68, 100, 117, 0.65);
	border-right-color: rgba(68, 100, 117, 0.65);
	border-bottom-color: rgba(68, 100, 117, 0.65);
	border-left-color: rgba(68, 100, 117, 0.65);
}

.hud-event-entry__indicator {
	width: 3px;
	height: 21px;
	background-color: rgb(123, 169, 191);
}

.hud-event-entry__message {
	flex-grow: 1;
	padding-left: 6px;
	padding-right: 6px;
	font-size: 9px;
	color: rgb(222, 233, 238);
}

.hud-event-entry--money .hud-event-entry__indicator {
	background-color: rgb(92, 211, 166);
}

.hud-event-entry--reputation .hud-event-entry__indicator {
	background-color: rgb(90, 177, 222);
}

.hud-event-entry--warning .hud-event-entry__indicator {
	background-color: rgb(226, 174, 72);
}

.hud-event-entry--error .hud-event-entry__indicator {
	background-color: rgb(224, 82, 82);
}

.economy-summary {
	height: 42px;
	flex-direction: row;
	align-items: center;
	padding-left: 8px;
	padding-right: 7px;
	overflow: hidden;
	background-color: rgba(12, 20, 29, 0.95);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-left-radius: 5px;
	border-bottom-right-radius: 5px;
}

.economy-summary:hover {
	background-color: rgba(22, 38, 50, 0.97);
	border-top-color: rgb(70, 169, 198);
	border-right-color: rgb(70, 169, 198);
	border-bottom-color: rgb(70, 169, 198);
	border-left-color: rgb(70, 169, 198);
}

.status-item {
	width: 82px;
	overflow: hidden;
}

.status-label {
	margin-bottom: 1px;
	font-size: 7px;
	-unity-font-style: bold;
	letter-spacing: 1.2px;
	color: rgb(126, 153, 166);
}

.status-value {
	font-size: 13px;
	-unity-font-style: bold;
	color: rgb(231, 240, 243);
}

.status-value--money {
	color: rgb(102, 220, 177);
}

.status-value--reputation {
	color: rgb(112, 191, 231);
}

.status-divider {
	width: 1px;
	height: 22px;
	margin-left: 3px;
	margin-right: 7px;
	background-color: rgba(93, 127, 143, 0.4);
}

.history-hint {
	display: none;
}

.time-cluster {
	position: absolute;
	left: 50%;
	bottom: 12px;
	translate: -50% 0;
	width: 405px;
	height: 63px;
	flex-direction: row;
	align-items: center;
	padding-left: 12px;
	padding-right: 9px;
	background-color: rgba(12, 20, 29, 0.95);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-left-radius: 5px;
	border-bottom-right-radius: 5px;
}

.date-block {
	width: 158px;
}

.date-block .status-label {
	font-size: 10px;
	letter-spacing: 1.8px;
}

.date-value {
	font-size: 15px;
	-unity-font-style: bold;
	color: rgb(224, 235, 240);
}

.time-divider {
	width: 1px;
	height: 33px;
	margin-left: 9px;
	margin-right: 8px;
	background-color: rgba(93, 127, 143, 0.4);
}

.speed-button {
	width: 38px;
	height: 35px;
	margin-left: 3px;
	padding: 0;
	font-size: 15px;
	color: rgb(191, 211, 220);
	background-color: rgb(30, 47, 61);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgb(58, 89, 105);
	border-right-color: rgb(58, 89, 105);
	border-bottom-color: rgb(58, 89, 105);
	border-left-color: rgb(58, 89, 105);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.speed-button:hover {
	color: rgb(238, 248, 251);
	background-color: rgb(43, 75, 91);
	border-top-color: rgb(77, 173, 200);
	border-right-color: rgb(77, 173, 200);
	border-bottom-color: rgb(77, 173, 200);
	border-left-color: rgb(77, 173, 200);
}

.speed-button:active {
	background-color: rgb(27, 111, 136);
}

.speed-button:disabled {
	opacity: 0.35;
}

.speed-value {
	min-width: 54px;
	margin-left: 6px;
	font-size: 15px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
	color: rgb(95, 206, 229);
}

.management-cluster {
	position: absolute;
	top: 12px;
	right: 12px;
	width: 128px;
}

.management-button {
	width: 128px;
	height: 30px;
	padding: 0;
	font-size: 10px;
	-unity-font-style: bold;
	color: rgb(211, 227, 234);
	background-color: rgba(12, 20, 29, 0.95);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.management-button:hover,
.management-button--open {
	color: rgb(238, 248, 251);
	background-color: rgb(31, 54, 67);
	border-top-color: rgb(77, 173, 200);
	border-right-color: rgb(77, 173, 200);
	border-bottom-color: rgb(77, 173, 200);
	border-left-color: rgb(77, 173, 200);
}

.management-menu {
	display: none;
	margin-top: 4px;
	padding-top: 3px;
	padding-right: 3px;
	padding-bottom: 3px;
	padding-left: 3px;
	background-color: rgba(12, 20, 29, 0.97);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.62);
	border-right-color: rgba(73, 126, 153, 0.62);
	border-bottom-color: rgba(73, 126, 153, 0.62);
	border-left-color: rgba(73, 126, 153, 0.62);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.management-menu__button {
	height: 26px;
	margin-top: 1px;
	margin-bottom: 1px;
	padding-left: 9px;
	font-size: 9px;
	-unity-font-style: bold;
	-unity-text-align: middle-left;
	color: rgb(191, 211, 220);
	background-color: rgba(25, 39, 50, 0.94);
	border-top-width: 0;
	border-right-width: 0;
	border-bottom-width: 0;
	border-left-width: 2px;
	border-left-color: rgba(73, 126, 153, 0.45);
}

.management-menu__button:hover {
	color: rgb(238, 248, 251);
	background-color: rgb(38, 65, 78);
	border-left-color: rgb(77, 173, 200);
}

.management-menu__button:active {
	background-color: rgb(27, 111, 136);
}

.selection-card {
	display: none;
	position: absolute;
	right: 12px;
	bottom: 12px;
	width: 270px;
	min-height: 150px;
	padding-top: 10px;
	padding-right: 10px;
	padding-bottom: 8px;
	padding-left: 12px;
	overflow: hidden;
	opacity: 1;
	translate: 0 0;
	scale: 1 1;
	transform-origin: 100% 100%;
	transition-property: opacity, translate, scale;
	transition-duration: 0.18s;
	transition-timing-function: ease-out;
	background-color: rgba(12, 20, 29, 0.96);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(73, 126, 153, 0.7);
	border-right-color: rgba(73, 126, 153, 0.7);
	border-bottom-color: rgba(73, 126, 153, 0.7);
	border-left-color: rgba(73, 126, 153, 0.7);
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-left-radius: 5px;
	border-bottom-right-radius: 5px;
}

.selection-card--reset { transition-duration: 0s; }
.selection-card--enter { opacity: 0; translate: 30px 18px; scale: 0.88 0.88; }
.selection-card__accent { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background-color: rgb(74, 186, 218); }
.selection-card__header { min-height: 35px; flex-direction: row; align-items: center; }
.selection-card__icon { width: 32px; height: 32px; margin-right: 9px; -unity-background-scale-mode: scale-to-fit; }
.selection-card__identity { flex-grow: 1; overflow: hidden; }
.selection-card__title { font-size: 12px; -unity-font-style: bold; color: rgb(231, 240, 243); white-space: nowrap; }
.selection-card__subtitle { margin-top: 2px; font-size: 8px; -unity-font-style: bold; letter-spacing: 0.8px; color: rgb(103, 196, 220); white-space: nowrap; }
.selection-card__divider { height: 1px; margin-top: 7px; margin-bottom: 5px; background-color: rgba(93, 127, 143, 0.38); }
.selection-card__info-list { min-height: 44px; }
.selection-card-info-row { height: 20px; flex-direction: row; align-items: center; }
.selection-card-info-row__key { flex-grow: 1; font-size: 8px; color: rgb(126, 153, 166); }
.selection-card-info-row__value { max-width: 145px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-right; color: rgb(218, 231, 236); white-space: nowrap; }
.selection-card__actions { height: 29px; flex-direction: row; justify-content: flex-end; align-items: flex-end; margin-top: 5px; }
.selection-card__button { width: 68px; height: 24px; margin-left: 4px; padding: 0; font-size: 8px; -unity-font-style: bold; color: rgb(191, 211, 220); background-color: rgb(30, 47, 61); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(58, 89, 105); border-right-color: rgb(58, 89, 105); border-bottom-color: rgb(58, 89, 105); border-left-color: rgb(58, 89, 105); }
.selection-card__button:hover { color: rgb(238, 248, 251); background-color: rgb(43, 75, 91); border-top-color: rgb(77, 173, 200); border-right-color: rgb(77, 173, 200); border-bottom-color: rgb(77, 173, 200); border-left-color: rgb(77, 173, 200); }
.selection-card__button--primary { color: rgb(225, 239, 244); background-color: rgb(31, 89, 108); border-top-color: rgb(65, 151, 177); border-right-color: rgb(65, 151, 177); border-bottom-color: rgb(65, 151, 177); border-left-color: rgb(65, 151, 177); }
.selection-card__inspector { display: none; margin-top: 4px; padding-top: 3px; border-top-width: 1px; border-top-color: rgba(93, 127, 143, 0.38); }
.selection-card__detail-tabs { display: none; height: 25px; flex-direction: row; margin-bottom: 5px; }
.selection-card__section-title { height: 18px; font-size: 7px; -unity-font-style: bold; letter-spacing: 0.9px; color: rgb(103, 196, 220); -unity-text-align: middle-left; }
.selection-card__section-title--actions { margin-top: 5px; }
.selection-card__overview-list { min-height: 60px; }
.selection-card__context-actions { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; min-height: 25px; }
.selection-card__context-button { height: 24px; min-width: 82px; margin-left: 4px; margin-bottom: 4px; padding-left: 8px; padding-right: 8px; font-size: 8px; -unity-font-style: bold; color: rgb(208, 224, 230); background-color: rgb(30, 47, 61); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(58, 89, 105); border-right-color: rgb(58, 89, 105); border-bottom-color: rgb(58, 89, 105); border-left-color: rgb(58, 89, 105); }
.selection-card__context-button:hover { background-color: rgb(43, 75, 91); border-top-color: rgb(77, 173, 200); border-right-color: rgb(77, 173, 200); border-bottom-color: rgb(77, 173, 200); border-left-color: rgb(77, 173, 200); }
.selection-card__context-button--danger { color: rgb(238, 177, 164); background-color: rgb(71, 39, 39); border-top-color: rgb(122, 63, 58); border-right-color: rgb(122, 63, 58); border-bottom-color: rgb(122, 63, 58); border-left-color: rgb(122, 63, 58); }
.selection-card--expanded { min-height: 280px; }
.selection-card--expanded .selection-card__info-list { display: none; }
