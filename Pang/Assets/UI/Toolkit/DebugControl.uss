.debug-control-tab {
	flex-grow: 1;
	padding-top: 20px;
	padding-right: 22px;
	padding-bottom: 22px;
	padding-left: 22px;
	background-color: rgba(10, 18, 25, 0.96);
}

.debug-control-heading {
	margin-bottom: 8px;
	font-size: 18px;
	-unity-font-style: bold;
	letter-spacing: 1.2px;
	color: rgb(105, 205, 232);
}

.debug-control-description {
	margin-bottom: 18px;
	font-size: 12px;
	white-space: normal;
	color: rgb(210, 224, 230);
}

.debug-control-fields {
	margin-bottom: 10px;
	padding-top: 12px;
	padding-right: 14px;
	padding-bottom: 8px;
	padding-left: 14px;
	background-color: rgba(23, 38, 49, 0.9);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgba(71, 119, 139, 0.75);
	border-right-color: rgba(71, 119, 139, 0.75);
	border-bottom-color: rgba(71, 119, 139, 0.75);
	border-left-color: rgba(71, 119, 139, 0.75);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.debug-control-field {
	margin-bottom: 8px;
}

.debug-control-field > Label {
	min-width: 135px;
	color: rgb(165, 190, 201);
}

.debug-control-field .unity-base-text-field__input {
	background-color: rgb(8, 14, 20);
	color: rgb(231, 240, 243);
}

.debug-control-hint {
	margin-top: 4px;
	font-size: 10px;
	white-space: normal;
	color: rgb(135, 157, 168);
}

.debug-control-message {
	margin-top: 18px;
	padding-top: 10px;
	padding-right: 12px;
	padding-bottom: 10px;
	padding-left: 12px;
	font-size: 11px;
	white-space: normal;
	color: rgb(217, 231, 236);
	background-color: rgba(5, 11, 16, 0.9);
	border-left-width: 3px;
	border-left-color: rgb(70, 169, 198);
}

.debug-item-toolbar {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 10px;
	padding-top: 8px;
	padding-right: 10px;
	padding-bottom: 8px;
	padding-left: 10px;
	background-color: rgba(23, 38, 49, 0.9);
}

.debug-item-selection {
	flex-grow: 1;
	white-space: normal;
	color: rgb(217, 231, 236);
}

.debug-item-refresh {
	min-width: 72px;
	margin-left: 10px;
}

.debug-item-grant {
	flex-direction: row;
	align-items: flex-end;
	margin-bottom: 8px;
}

.debug-item-grant-item {
	flex-grow: 1;
}

.debug-item-grant-quantity {
	width: 130px;
	margin-left: 8px;
}

.debug-item-grant-button {
	min-width: 64px;
	margin-left: 8px;
}

.debug-item-list {
	flex-grow: 1;
	min-height: 190px;
	max-height: 310px;
	margin-bottom: 8px;
	padding-top: 6px;
	padding-right: 6px;
	padding-bottom: 6px;
	padding-left: 6px;
	background-color: rgba(5, 11, 16, 0.72);
}

.debug-item-empty {
	padding-top: 12px;
	padding-left: 8px;
	color: rgb(135, 157, 168);
}

.debug-item-row {
	margin-bottom: 6px;
	padding-top: 8px;
	padding-right: 10px;
	padding-bottom: 8px;
	padding-left: 10px;
	background-color: rgba(23, 38, 49, 0.95);
	border-left-width: 2px;
	border-left-color: rgba(71, 119, 139, 0.9);
}

.debug-item-row-header {
	flex-direction: row;
	justify-content: space-between;
	margin-bottom: 5px;
}

.debug-item-row-name {
	-unity-font-style: bold;
	color: rgb(231, 240, 243);
}

.debug-item-row-quantity {
	color: rgb(165, 190, 201);
}

.debug-item-condition-row {
	flex-direction: row;
	align-items: center;
	margin-top: 3px;
}

.debug-item-condition-name {
	width: 78px;
	color: rgb(165, 190, 201);
}

.debug-item-condition-value {
	width: 36px;
	-unity-text-align: middle-right;
	color: rgb(105, 205, 232);
}

.debug-item-adjust-button {
	min-width: 38px;
	margin-left: 4px;
	padding-left: 5px;
	padding-right: 5px;
}

.debug-money-current {
	margin-bottom: 10px;
	font-size: 14px;
	-unity-font-style: bold;
	color: rgb(105, 205, 232);
}

.debug-money-controls {
	flex-direction: row;
	align-items: flex-end;
	margin-bottom: 10px;
	padding-top: 12px;
	padding-right: 14px;
	padding-bottom: 8px;
	padding-left: 14px;
	background-color: rgba(23, 38, 49, 0.9);
}

.debug-money-value {
	flex-grow: 1;
}

.debug-money-apply {
	min-width: 72px;
	margin-bottom: 8px;
	margin-left: 8px;
}

.debug-research-controls {
	flex-direction: row;
	align-items: flex-end;
	margin-bottom: 10px;
	padding-top: 12px;
	padding-right: 14px;
	padding-bottom: 8px;
	padding-left: 14px;
	background-color: rgba(23, 38, 49, 0.9);
}

.debug-research-select {
	flex-grow: 1;
}

.debug-research-action,
.debug-research-return {
	min-width: 112px;
	margin-bottom: 2px;
	margin-left: 8px;
}
