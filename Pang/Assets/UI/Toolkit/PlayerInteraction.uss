.player-interaction-content {
	flex-grow: 1;
}

.player-interaction-header {
	height: 56px;
	flex-direction: row;
	align-items: center;
	padding-left: 12px;
	padding-right: 10px;
	background-color: rgb(25, 36, 44);
	border-left-width: 3px;
	border-left-color: rgb(74, 186, 218);
}

.player-interaction-header__identity {
	flex-grow: 1;
}

.player-interaction-title {
	font-size: 16px;
	-unity-font-style: bold;
	color: rgb(230, 240, 244);
}

.player-interaction-subtitle,
.player-interaction-pane__eyebrow,
.player-interaction-field-label {
	margin-top: 3px;
	font-size: 10px;
	-unity-font-style: bold;
	letter-spacing: 1px;
	color: rgb(93, 178, 207);
}

.player-interaction-refresh {
	width: 78px;
	height: 27px;
	font-size: 11px;
	color: rgb(208, 224, 230);
	background-color: rgb(35, 55, 67);
	border-top-color: rgb(62, 96, 111);
	border-right-color: rgb(62, 96, 111);
	border-bottom-color: rgb(62, 96, 111);
	border-left-color: rgb(62, 96, 111);
}

.player-interaction-target-bar {
	height: 50px;
	flex-direction: row;
	align-items: center;
	margin-top: 8px;
	padding-left: 10px;
	padding-right: 10px;
	background-color: rgb(23, 32, 39);
}

.player-interaction-field-label {
	width: 130px;
	margin-top: 0;
}

.player-interaction-target {
	flex-grow: 1;
	height: 28px;
	font-size: 11px;
}

.player-interaction-kinds {
	min-width: 125px;
	margin-left: 10px;
	font-size: 11px;
	-unity-font-style: bold;
	-unity-text-align: middle-right;
	color: rgb(102, 220, 177);
}

.player-interaction-message {
	min-height: 28px;
	margin-top: 6px;
	padding-left: 10px;
	padding-right: 10px;
	padding-top: 7px;
	white-space: normal;
	font-size: 11px;
	color: rgb(199, 174, 108);
	background-color: rgba(52, 45, 31, 0.55);
}

.player-interaction-panes {
	flex-grow: 1;
	flex-direction: row;
	margin-top: 8px;
}

.player-interaction-pane {
	min-width: 0;
	flex-grow: 1;
	padding: 9px;
	background-color: rgb(25, 35, 43);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 2px;
	border-top-color: rgb(48, 65, 75);
	border-right-color: rgb(48, 65, 75);
	border-bottom-color: rgb(48, 65, 75);
	border-left-color: rgb(65, 119, 140);
}

.player-interaction-pane--target {
	border-left-color: rgb(74, 186, 218);
}

.player-interaction-pane__header {
	height: 48px;
	flex-direction: row;
	align-items: center;
}

.player-interaction-pane__identity {
	min-width: 0;
	flex-grow: 1;
}

.player-interaction-pane__title {
	margin-top: 3px;
	font-size: 13px;
	-unity-font-style: bold;
	color: rgb(224, 235, 240);
	white-space: nowrap;
}

.player-interaction-pane__capacity {
	margin-left: 8px;
	font-size: 10px;
	-unity-font-style: bold;
	color: rgb(102, 220, 177);
}

.player-interaction-list-header {
	height: 23px;
	flex-direction: row;
	align-items: center;
	padding-left: 7px;
	padding-right: 7px;
	background-color: rgb(19, 28, 34);
	border-bottom-width: 1px;
	border-bottom-color: rgb(54, 71, 81);
}

.player-interaction-list-header Label {
	font-size: 9px;
	-unity-font-style: bold;
	letter-spacing: 0.6px;
	color: rgb(108, 140, 155);
}

.player-interaction-list-header__item {
	flex-grow: 1;
}

.player-interaction-list-header__quantity {
	width: 50px;
	-unity-text-align: middle-right;
}

.player-interaction-list-header__move {
	width: 142px;
	-unity-text-align: middle-center;
}

.player-interaction-list {
	flex-grow: 1;
	margin-top: 3px;
}

.player-interaction-empty {
	display: none;
	position: absolute;
	left: 12px;
	right: 12px;
	top: 150px;
	white-space: normal;
	font-size: 11px;
	-unity-text-align: middle-center;
	color: rgb(112, 137, 149);
}

.player-interaction-pane-separator {
	width: 44px;
	align-items: center;
	justify-content: center;
}

.player-interaction-pane-separator__icon {
	font-size: 23px;
	color: rgb(77, 173, 200);
}

.player-interaction-whole-button {
	height: 30px;
	margin-top: 7px;
	font-size: 11px;
	-unity-font-style: bold;
	color: rgb(208, 224, 230);
	background-color: rgb(35, 55, 67);
	border-top-color: rgb(62, 96, 111);
	border-right-color: rgb(62, 96, 111);
	border-bottom-color: rgb(62, 96, 111);
	border-left-color: rgb(62, 96, 111);
}

.player-interaction-whole-button--primary {
	color: rgb(230, 245, 250);
	background-color: rgb(31, 89, 108);
	border-top-color: rgb(65, 151, 177);
	border-right-color: rgb(65, 151, 177);
	border-bottom-color: rgb(65, 151, 177);
	border-left-color: rgb(65, 151, 177);
}

.player-interaction-footer {
	height: 42px;
	flex-direction: row;
	align-items: center;
	margin-top: 8px;
	padding-left: 10px;
	padding-right: 8px;
	background-color: rgb(22, 30, 36);
}

.player-interaction-footer__hint {
	flex-grow: 1;
	font-size: 10px;
	color: rgb(121, 145, 157);
}

.player-interaction-release {
	width: 120px;
	height: 28px;
	font-size: 11px;
	-unity-font-style: bold;
	color: rgb(238, 177, 164);
	background-color: rgb(71, 39, 39);
	border-top-color: rgb(122, 63, 58);
	border-right-color: rgb(122, 63, 58);
	border-bottom-color: rgb(122, 63, 58);
	border-left-color: rgb(122, 63, 58);
}

.player-interaction-item-row {
	min-height: 51px;
	flex-direction: row;
	align-items: center;
	margin-bottom: 3px;
	padding-left: 7px;
	padding-right: 6px;
	background-color: rgb(31, 42, 50);
	border-left-width: 2px;
	border-left-color: rgb(65, 119, 140);
}

.player-interaction-item-row__identity {
	min-width: 0;
	flex-grow: 1;
}

.player-interaction-item-row__name {
	font-size: 10px;
	-unity-font-style: bold;
	color: rgb(224, 235, 240);
	white-space: nowrap;
}

.player-interaction-item-row__state {
	margin-top: 2px;
	font-size: 9px;
	color: rgb(122, 151, 164);
	white-space: nowrap;
}

.player-interaction-item-row__quantity {
	width: 50px;
	font-size: 10px;
	-unity-font-style: bold;
	-unity-text-align: middle-right;
	color: rgb(102, 220, 177);
}

.player-interaction-item-row__command {
	width: 142px;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
}

.player-interaction-item-row__field {
	width: 64px;
	height: 25px;
	margin-right: 5px;
	font-size: 11px;
}

.player-interaction-item-row__button {
	width: 68px;
	height: 25px;
	font-size: 10px;
	-unity-font-style: bold;
	color: rgb(225, 239, 244);
	background-color: rgb(31, 89, 108);
	border-top-color: rgb(65, 151, 177);
	border-right-color: rgb(65, 151, 177);
	border-bottom-color: rgb(65, 151, 177);
	border-left-color: rgb(65, 151, 177);
}

.player-interaction-item-row__button:disabled,
.player-interaction-whole-button:disabled,
.player-interaction-release:disabled {
	opacity: 0.42;
}
