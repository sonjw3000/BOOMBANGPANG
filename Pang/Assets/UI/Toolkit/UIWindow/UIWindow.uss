.ui-window {
	position: absolute;
	left: 50%;
	top: 50%;
	translate: -50% -50%;
	width: 720px;
	height: 520px;
	background-color: rgb(28, 31, 38);
	border-left-width: 1px;
	border-right-width: 1px;
	border-top-width: 1px;
	border-bottom-width: 1px;
	border-left-color: rgb(72, 78, 90);
	border-right-color: rgb(72, 78, 90);
	border-top-color: rgb(72, 78, 90);
	border-bottom-color: rgb(72, 78, 90);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.ui-window__title-bar {
	height: 44px;
	min-height: 44px;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-left: 12px;
	background-color: rgb(40, 44, 53);
	border-bottom-width: 1px;
	border-bottom-color: rgb(72, 78, 90);
}

.ui-window__title-left {
	flex-direction: row;
	align-items: center;
	flex-grow: 1;
}

.ui-window__icon {
	width: 24px;
	height: 24px;
	margin-right: 8px;
	background-size: contain;
	-unity-background-scale-mode: scale-to-fit;
}

.ui-window__title {
	color: rgb(235, 238, 244);
	font-size: 16px;
	-unity-font-style: bold;
}

.ui-window__close-button {
	width: 44px;
	height: 42px;
	margin-left: auto;
	margin-right: 0;
	border-left-width: 0;
	border-right-width: 0;
	border-top-width: 0;
	border-bottom-width: 0;
	border-top-left-radius: 0;
	border-top-right-radius: 0;
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
	background-color: rgba(0, 0, 0, 0);
	color: rgb(220, 224, 232);
	font-size: 22px;
}

.ui-window__close-button:hover {
	background-color: rgb(184, 50, 55);
	color: white;
}

.ui-window__tab-bar {
	height: 38px;
	min-height: 38px;
	flex-direction: row;
	align-items: flex-end;
	padding-left: 8px;
	padding-right: 8px;
	background-color: rgb(33, 36, 44);
	border-bottom-width: 1px;
	border-bottom-color: rgb(72, 78, 90);
}

.ui-window__tab-button {
	height: 34px;
	margin-right: 2px;
	padding-left: 14px;
	padding-right: 14px;
	border-left-width: 0;
	border-right-width: 0;
	border-top-width: 0;
	border-bottom-width: 2px;
	border-bottom-color: rgba(0, 0, 0, 0);
	background-color: rgba(0, 0, 0, 0);
	color: rgb(164, 170, 182);
}

.ui-window__tab-button:hover {
	background-color: rgb(47, 51, 61);
	color: rgb(235, 238, 244);
}

.ui-window__tab-button--selected {
	border-bottom-color: rgb(79, 156, 255);
	color: white;
}

.ui-window__content-root {
	flex-grow: 1;
	padding-left: 16px;
	padding-right: 16px;
	padding-top: 16px;
	padding-bottom: 16px;
}
