.ui-window {
	position: absolute;
	left: 50%;
	top: 50%;
	translate: -50% -50%;
	width: 1400px;
	height: 900px;
	background-color: rgb(28, 31, 38);
	border-left-width: 1px;
	border-right-width: 1px;
	border-top-width: 1px;
	border-bottom-width: 1px;
	border-left-color: rgb(72, 78, 90);
	border-right-color: rgb(72, 78, 90);
	border-top-color: rgb(72, 78, 90);
	border-bottom-color: rgb(72, 78, 90);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.ui-window__title-bar {
	height: 36px;
	min-height: 36px;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-left: 9px;
	background-color: rgb(40, 44, 53);
	border-bottom-width: 1px;
	border-bottom-color: rgb(72, 78, 90);
}

.ui-window__title-bar:hover {
	background-color: rgb(44, 50, 60);
}

.ui-window__title-left {
	flex-direction: row;
	align-items: center;
	flex-grow: 1;
}

.ui-window__icon {
	width: 18px;
	height: 18px;
	margin-right: 6px;
	background-size: contain;
	-unity-background-scale-mode: scale-to-fit;
}

.ui-window__title {
	color: rgb(235, 238, 244);
	font-size: 13px;
	-unity-font-style: bold;
}

.ui-window__close-button {
	width: 36px;
	height: 34px;
	margin-left: auto;
	margin-right: 0;
	border-left-width: 0;
	border-right-width: 0;
	border-top-width: 0;
	border-bottom-width: 0;
	border-top-left-radius: 0;
	border-top-right-radius: 0;
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
	background-color: rgba(0, 0, 0, 0);
	color: rgb(220, 224, 232);
	font-size: 18px;
}

.ui-window__close-button:hover {
	background-color: rgb(184, 50, 55);
	color: white;
}

.ui-window__tab-bar {
	position: relative;
	height: 31px;
	min-height: 31px;
	flex-direction: row;
	align-items: flex-end;
	padding-left: 6px;
	padding-right: 6px;
	background-color: rgb(33, 36, 44);
}

.ui-window__tab-separator {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 1px;
	background-color: rgb(72, 78, 90);
}

.ui-window__tab-button {
	height: 30px;
	margin-right: 2px;
	padding-left: 10px;
	padding-right: 10px;
	border-left-width: 0;
	border-right-width: 0;
	border-top-width: 0;
	border-bottom-width: 2px;
	border-bottom-color: rgba(0, 0, 0, 0);
	background-color: rgba(0, 0, 0, 0);
	color: rgb(164, 170, 182);
	font-size: 11px;
}

.ui-window__tab-button:hover {
	background-color: rgb(47, 51, 61);
	color: rgb(235, 238, 244);
}

.ui-window__tab-button--selected {
	border-bottom-color: rgb(79, 156, 255);
	color: white;
}

.ui-window__content-root {
	flex-grow: 1;
	padding-left: 10px;
	padding-right: 10px;
	padding-top: 10px;
	padding-bottom: 10px;
}

.ui-window .unity-scroller {
	background-color: rgb(22, 25, 31);
	border-left-width: 0;
	border-right-width: 0;
	border-top-width: 0;
	border-bottom-width: 0;
}

.ui-window .unity-scroller--vertical {
	width: 10px;
	margin-left: 5px;
}

.ui-window .unity-scroller--horizontal {
	height: 10px;
	margin-top: 5px;
}

.ui-window .unity-scroller > .unity-repeat-button {
	display: none;
}

.ui-window .unity-scroller > .unity-scroller__slider {
	margin-left: 0;
	margin-right: 0;
	margin-top: 0;
	margin-bottom: 0;
}

.ui-window .unity-scroller--vertical > .unity-scroller__slider {
	width: 10px;
	min-width: 10px;
}

.ui-window .unity-scroller--horizontal > .unity-scroller__slider {
	height: 10px;
	min-height: 10px;
}

.ui-window .unity-scroller .unity-base-slider__tracker {
	background-color: rgb(22, 25, 31);
	border-left-width: 0;
	border-right-width: 0;
	border-top-width: 0;
	border-bottom-width: 0;
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-left-radius: 5px;
	border-bottom-right-radius: 5px;
}

.ui-window .unity-scroller .unity-base-slider__dragger {
	background-color: rgb(79, 96, 112);
	border-left-width: 0;
	border-right-width: 0;
	border-top-width: 0;
	border-bottom-width: 0;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.ui-window .unity-scroller .unity-base-slider__dragger:hover {
	background-color: rgb(92, 131, 158);
}

.ui-window .unity-scroller--vertical .unity-base-slider__dragger {
	min-height: 28px;
}

.ui-window .unity-scroller--horizontal .unity-base-slider__dragger {
	min-width: 28px;
}

.ui-window__resize-handle {
	position: absolute;
}

.ui-window__resize-handle--top {
	left: 10px;
	right: 10px;
	top: 0;
	height: 6px;
}

.ui-window__resize-handle--right {
	right: 0;
	top: 10px;
	bottom: 10px;
	width: 6px;
}

.ui-window__resize-handle--bottom {
	left: 10px;
	right: 10px;
	bottom: 0;
	height: 6px;
}

.ui-window__resize-handle--left {
	left: 0;
	top: 10px;
	bottom: 10px;
	width: 6px;
}

.ui-window__resize-handle--corner {
	width: 12px;
	height: 12px;
}

.ui-window__resize-handle--top-left {
	left: 0;
	top: 0;
}

.ui-window__resize-handle--top-right {
	right: 0;
	top: 0;
}

.ui-window__resize-handle--bottom-left {
	left: 0;
	bottom: 0;
}

.ui-window__resize-handle--bottom-right {
	right: 0;
	bottom: 0;
	border-right-width: 2px;
	border-bottom-width: 2px;
	border-right-color: rgb(105, 122, 136);
	border-bottom-color: rgb(105, 122, 136);
}
