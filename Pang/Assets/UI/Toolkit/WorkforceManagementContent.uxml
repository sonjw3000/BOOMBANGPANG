<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="WorkforceManagement.uss" />
	<ui:VisualElement class="workforce-content">
		<ui:VisualElement class="workforce-tabs">
			<ui:VisualElement class="workforce-tabs__separator" picking-mode="Ignore" />
			<ui:Button name="workforce-assignments-button" text="Assignments" class="workforce-tab-button" />
			<ui:Button name="workforce-roster-button" text="Workers" class="workforce-tab-button" />
			<ui:Button name="workforce-hiring-button" text="Hiring" class="workforce-tab-button" />
		</ui:VisualElement>
		<ui:VisualElement name="workforce-assignments-tab" class="workforce-tab workforce-assignments">
			<ui:VisualElement class="workforce-summary">
				<ui:Label name="workforce-total" text="TOTAL 0" class="workforce-summary__item" />
				<ui:Label name="workforce-unassigned" text="UNASSIGNED 0" class="workforce-summary__item" />
				<ui:Label name="workforce-working" text="WORKING 0" class="workforce-summary__item" />
				<ui:Label name="workforce-blocked" text="BLOCKED 0" class="workforce-summary__item workforce-summary__item--warning" />
				<ui:Label name="workforce-payroll" text="PAYROLL $0 / MONTH" class="workforce-summary__item workforce-summary__item--payroll" />
			</ui:VisualElement>
			<ui:VisualElement class="workforce-assignment-columns">
				<ui:VisualElement class="workforce-unassigned-column">
					<ui:VisualElement class="workforce-assignment-column-header">
						<ui:Label text="UNASSIGNED" class="workforce-column-label" />
						<ui:Label name="workforce-unassigned-count" text="0 WORKERS" class="workforce-assignment-column-count" />
					</ui:VisualElement>
					<ui:ScrollView name="workforce-unassigned-list" class="workforce-assignment-list" />
					<ui:Label name="workforce-unassigned-empty" text="All operational workers have a role." class="workforce-assignment-empty" />
				</ui:VisualElement>
				<ui:VisualElement class="workforce-assignment-tree-column">
					<ui:VisualElement class="workforce-assignment-column-header">
						<ui:Label text="PUBLIC &amp; BUILDINGS" class="workforce-column-label" />
						<ui:Label text="CURRENT OPERATIONAL ASSIGNMENTS" class="workforce-assignment-column-count" />
					</ui:VisualElement>
					<ui:ScrollView name="workforce-assignment-tree" class="workforce-assignment-tree" />
					<ui:Label name="workforce-assignment-tree-empty" text="No workforce scopes are available." class="workforce-assignment-empty" />
				</ui:VisualElement>
			</ui:VisualElement>
		</ui:VisualElement>
		<ui:VisualElement name="workforce-roster-tab" class="workforce-tab">
			<ui:VisualElement class="workforce-columns">
				<ui:VisualElement class="workforce-roster-column">
					<ui:VisualElement class="workforce-toolbar">
						<ui:Label text="WORKERS" class="workforce-column-label" />
						<ui:Button name="workforce-assignment-mode-button" text="Assign on Map" class="workforce-assignment-mode-button" />
						<ui:DropdownField name="worker-filter-field" class="workforce-filter" />
					</ui:VisualElement>
					<ui:Label name="workforce-assignment-status" text="" class="workforce-assignment-status" />
					<ui:ScrollView name="worker-list" class="workforce-list" />
					<ui:Label name="worker-list-empty" text="No workers match this filter." class="workforce-empty" />
					<ui:VisualElement name="workforce-outdoor-drop-zone" class="workforce-outdoor-drop-zone">
						<ui:Label text="PUBLIC LOGISTICS" class="workforce-outdoor-drop-zone__title" />
						<ui:Label text="Drop here for Loading / Unloading / Cargo Transfer" class="workforce-outdoor-drop-zone__description" />
					</ui:VisualElement>
				</ui:VisualElement>
				<ui:VisualElement class="workforce-detail-column">
					<ui:Label name="workforce-detail-title" text="SELECTED WORKER" class="workforce-column-label" />
					<ui:VisualElement name="worker-detail-empty" class="workforce-detail-empty">
						<ui:Label text="Select a worker to inspect and configure." />
					</ui:VisualElement>
					<ui:VisualElement name="worker-detail" class="workforce-detail">
						<ui:Label name="worker-detail-name" text="Worker" class="workforce-detail__name" />
						<ui:Label name="worker-detail-kind" text="Human" class="workforce-detail__subtext" />
						<ui:VisualElement class="workforce-detail__facts">
							<ui:Label name="worker-detail-status" text="STATUS Idle" class="workforce-detail__fact" />
							<ui:Label name="worker-detail-condition" text="FATIGUE 0%" class="workforce-detail__fact" />
							<ui:Label name="worker-detail-wear" text="WEAR --" class="workforce-detail__fact" />
							<ui:Label name="worker-detail-pay" text="$0 / MONTH" class="workforce-detail__fact" />
						</ui:VisualElement>
						<ui:Label text="PRIMARY BUILDING" class="workforce-field-label" />
						<ui:DropdownField name="worker-building-field" class="workforce-field" />
						<ui:Label text="HANDLE GROUP" class="workforce-field-label" />
						<ui:DropdownField name="worker-handle-field" class="workforce-field" />
						<ui:Label text="ALLOWED TASKS" class="workforce-field-label" />
						<ui:ScrollView name="worker-task-toggles" class="workforce-task-list" />
						<ui:Label name="worker-assignment-message" text="" class="workforce-assignment-message" />
					</ui:VisualElement>
					<ui:VisualElement name="workforce-building-detail" class="workforce-building-detail">
						<ui:Label name="workforce-building-name" text="Building" class="workforce-detail__name" />
						<ui:Label name="workforce-building-summary" text="WORKERS 0" class="workforce-building-summary" />
						<ui:ScrollView name="workforce-building-matrix" mode="VerticalAndHorizontal" class="workforce-building-matrix" />
						<ui:Label name="workforce-building-empty" text="No workers are assigned to this building." class="workforce-building-empty" />
					</ui:VisualElement>
				</ui:VisualElement>
			</ui:VisualElement>
		</ui:VisualElement>
		<ui:VisualElement name="workforce-hiring-tab" class="workforce-tab workforce-hiring">
			<ui:VisualElement class="workforce-category-column">
				<ui:Label text="MARKETS" class="workforce-column-label" />
				<ui:ScrollView name="workforce-category-list" class="workforce-list" />
			</ui:VisualElement>
			<ui:VisualElement class="workforce-candidate-column">
				<ui:VisualElement class="workforce-hiring-toolbar">
					<ui:Label text="CANDIDATES" class="workforce-column-label" />
					<ui:Button name="create-worker-spawn-area-button" text="Create Spawn Area" class="workforce-create-area-button" />
				</ui:VisualElement>
				<ui:Label name="workforce-hiring-message" text="Select a workforce market." class="workforce-message" />
				<ui:ScrollView name="workforce-candidate-list" class="workforce-list" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
