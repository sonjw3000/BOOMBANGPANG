<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="DebugControl.uss" />
	<ui:VisualElement name="debug-explosion-tab" class="debug-control-tab">
		<ui:Label text="EXPLOSION" class="debug-control-heading" />
		<ui:Label text="Left-click a grid cell to enqueue an explosion on the next simulation tick." class="debug-control-description" />
		<ui:VisualElement class="debug-control-fields">
			<ui:IntegerField name="debug-explosion-radius" label="Radius" value="3" is-delayed="true" class="debug-control-field" />
			<ui:IntegerField name="debug-explosion-severity" label="Severity" value="50" is-delayed="true" class="debug-control-field" />
		</ui:VisualElement>
		<ui:Label text="Radius is measured in grid cells. Severity is clamped to 1-100." class="debug-control-hint" />
		<ui:Label name="debug-explosion-message" text="Ready. Select a grid cell." class="debug-control-message" />
	</ui:VisualElement>

	<ui:VisualElement name="debug-damage-tab" class="debug-control-tab">
		<ui:Label text="DAMAGE" class="debug-control-heading" />
		<ui:Label text="Left-click a grid cell to damage its IHealth GridPlaceable. Facilities at zero health use the normal destruction path." class="debug-control-description" />
		<ui:VisualElement class="debug-control-fields">
			<ui:FloatField name="debug-damage-amount" label="Damage Amount" value="25" is-delayed="true" class="debug-control-field" />
		</ui:VisualElement>
		<ui:Label name="debug-damage-message" text="Ready. Select a damageable GridPlaceable." class="debug-control-message" />
	</ui:VisualElement>

	<ui:VisualElement name="debug-worker-tab" class="debug-control-tab">
		<ui:Label text="WORKER" class="debug-control-heading" />
		<ui:Label text="Left-click a worker to change its operational state to Knockout. The worker returns its current task through TaskManager for recovery verification." class="debug-control-description" />
		<ui:Label text="Workers that are already incapacitated are left unchanged." class="debug-control-hint" />
		<ui:Label name="debug-worker-message" text="Ready. Select a worker." class="debug-control-message" />
	</ui:VisualElement>

	<ui:VisualElement name="debug-item-tab" class="debug-control-tab">
		<ui:Label text="ITEM" class="debug-control-heading" />
		<ui:Label text="Left-click a worker carrying a box or a direct item container to inspect its stacks." class="debug-control-description" />
		<ui:VisualElement class="debug-item-toolbar">
			<ui:Label name="debug-item-selection" text="Selected: None" class="debug-item-selection" />
			<ui:Button name="debug-item-refresh" text="Refresh" class="debug-item-refresh" />
		</ui:VisualElement>
		<ui:ScrollView name="debug-item-list" mode="Vertical" class="debug-item-list">
			<ui:Label name="debug-item-empty" text="Select an item container." class="debug-item-empty" />
		</ui:ScrollView>
		<ui:Label text="Damage increases use ItemDamageService and can trigger configured incidents. Damage decreases are debug repairs." class="debug-control-hint" />
		<ui:Label name="debug-item-message" text="Ready. Select a worker or item container." class="debug-control-message" />
	</ui:VisualElement>
</ui:UXML>
