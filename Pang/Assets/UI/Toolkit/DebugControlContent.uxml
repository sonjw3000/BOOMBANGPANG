<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="DebugControl.uss" />
	<ui:VisualElement name="debug-explosion-tab" class="debug-control-tab">
		<ui:Label text="EXPLOSION" class="debug-control-heading" />
		<ui:Label text="Left-click a grid cell to enqueue an explosion on the next simulation tick." class="debug-control-description" />
		<ui:VisualElement class="debug-control-fields">
			<ui:IntegerField name="debug-explosion-radius" label="Radius" value="3" is-delayed="true" class="debug-control-field" />
			<ui:IntegerField name="debug-explosion-severity" label="Severity" value="50" is-delayed="true" class="debug-control-field" />
		</ui:VisualElement>
		<ui:Label text="Radius is measured in grid cells. Severity is clamped to 1-100." class="debug-control-hint" />
		<ui:Label name="debug-explosion-message" text="Ready. Select a grid cell." class="debug-control-message" />
	</ui:VisualElement>

	<ui:VisualElement name="debug-fire-tab" class="debug-control-tab">
		<ui:Label text="FIRE" class="debug-control-heading" />
		<ui:Label text="Left-click a grid cell to apply FireIntensity to its IGridPlaceable targets and any carried Box." class="debug-control-description" />
		<ui:VisualElement class="debug-control-fields">
			<ui:IntegerField name="debug-fire-intensity" label="Fire Intensity" value="25" is-delayed="true" class="debug-control-field" />
		</ui:VisualElement>
		<ui:Label text="Fire grows or weakens by 25 per simulation tick. Ignition and sustain require at least 40% oxygen." class="debug-control-hint" />
		<ui:Label name="debug-fire-message" text="Ready. Select an IGridPlaceable." class="debug-control-message" />
	</ui:VisualElement>

	<ui:VisualElement name="debug-temperature-tab" class="debug-control-tab">
		<ui:Label text="TEMPERATURE" class="debug-control-heading" />
		<ui:Label text="Left-click a grid cell to set its absolute temperature in Celsius." class="debug-control-description" />
		<ui:VisualElement class="debug-control-fields">
			<ui:FloatField name="debug-temperature-celsius" label="Temperature °C" value="100" is-delayed="true" class="debug-control-field" />
		</ui:VisualElement>
		<ui:Label text="The value is applied through GridService and cannot go below absolute zero." class="debug-control-hint" />
		<ui:Label name="debug-temperature-message" text="Ready. Select a grid cell." class="debug-control-message" />
	</ui:VisualElement>

	<ui:VisualElement name="debug-damage-tab" class="debug-control-tab">
		<ui:Label text="DAMAGE" class="debug-control-heading" />
		<ui:Label text="Left-click a grid cell to apply absolute HP damage to its IHealth GridPlaceable. Facilities at zero health use the normal destruction path." class="debug-control-description" />
		<ui:VisualElement class="debug-control-fields">
			<ui:FloatField name="debug-damage-amount" label="Damage HP" value="25" is-delayed="true" class="debug-control-field" />
		</ui:VisualElement>
		<ui:Label name="debug-damage-message" text="Ready. Select a damageable GridPlaceable." class="debug-control-message" />
	</ui:VisualElement>

	<ui:VisualElement name="debug-worker-tab" class="debug-control-tab">
		<ui:Label text="WORKER" class="debug-control-heading" />
		<ui:Label text="Left-click a worker to change its operational state to Knockout. The worker returns its current task through TaskManager for recovery verification." class="debug-control-description" />
		<ui:Label text="Workers that are already incapacitated are left unchanged." class="debug-control-hint" />
		<ui:Label name="debug-worker-message" text="Ready. Select a worker." class="debug-control-message" />
	</ui:VisualElement>

	<ui:VisualElement name="debug-item-tab" class="debug-control-tab">
		<ui:Label text="ITEM" class="debug-control-heading" />
		<ui:Label text="Left-click a worker carrying a box or a direct item container to inspect its stacks." class="debug-control-description" />
		<ui:VisualElement class="debug-item-toolbar">
			<ui:Label name="debug-item-selection" text="Selected: None" class="debug-item-selection" />
			<ui:Button name="debug-item-refresh" text="Refresh" class="debug-item-refresh" />
		</ui:VisualElement>
		<ui:VisualElement class="debug-item-grant">
			<ui:DropdownField name="debug-item-grant-item" label="Item" class="debug-item-grant-item" />
			<ui:IntegerField name="debug-item-grant-quantity" label="Quantity" value="1" is-delayed="true" class="debug-item-grant-quantity" />
			<ui:Button name="debug-item-grant-button" text="Give" class="debug-item-grant-button" />
		</ui:VisualElement>
		<ui:ScrollView name="debug-item-list" mode="Vertical" class="debug-item-list">
			<ui:Label name="debug-item-empty" text="Select an item container." class="debug-item-empty" />
		</ui:ScrollView>
		<ui:Label text="Damage increases use ItemDamageService and can trigger configured incidents. Damage decreases are debug repairs." class="debug-control-hint" />
		<ui:Label name="debug-item-message" text="Ready. Select a worker or item container." class="debug-control-message" />
	</ui:VisualElement>

	<ui:VisualElement name="debug-money-tab" class="debug-control-tab">
		<ui:Label text="MONEY" class="debug-control-heading" />
		<ui:Label text="Set the company's current money through EconomyService." class="debug-control-description" />
		<ui:Label name="debug-money-current" text="Current Money: $0" class="debug-money-current" />
		<ui:VisualElement class="debug-money-controls">
			<ui:IntegerField name="debug-money-value" label="Money" value="0" is-delayed="true" class="debug-control-field debug-money-value" />
			<ui:Button name="debug-money-apply" text="Apply" class="debug-money-apply" />
		</ui:VisualElement>
		<ui:Label text="Applying creates a Debug Adjustment transaction so the change remains visible in economy history." class="debug-control-hint" />
		<ui:Label name="debug-money-message" text="Ready." class="debug-control-message" />
	</ui:VisualElement>
</ui:UXML>
