.workflow-content { flex-grow: 1; }
.workflow-tabs { position: relative; height: 30px; flex-direction: row; align-items: flex-end; margin-bottom: 9px; }
.workflow-tabs__separator { position: absolute; left: 0; right: 0; bottom: 0; height: 1px; background-color: rgb(65, 78, 88); }
.workflow-tab-button { width: 90px; height: 29px; margin-right: 3px; font-size: 10px; color: rgb(145, 163, 173); background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0); }
.workflow-tab-button--selected { color: rgb(232, 243, 247); border-bottom-color: rgb(74, 186, 218); }
.workflow-tab { position: relative; flex-grow: 1; padding-right: 4px; }
.workflow-heading { font-size: 14px; -unity-font-style: bold; color: rgb(231, 240, 243); }
.workflow-caption { margin-top: 2px; margin-bottom: 7px; font-size: 9px; color: rgb(125, 148, 160); white-space: normal; }
.workflow-section-toolbar { min-height: 42px; flex-direction: row; align-items: flex-start; }
.workflow-section-toolbar__text { flex-grow: 1; }
.workflow-action-button { width: 84px; height: 27px; font-size: 9px; -unity-font-style: bold; color: rgb(225, 239, 244); background-color: rgb(31, 89, 108); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(65, 151, 177); border-right-color: rgb(65, 151, 177); border-top-color: rgb(65, 151, 177); border-bottom-color: rgb(65, 151, 177); }
.workflow-action-button:hover { background-color: rgb(39, 119, 142); }
.workflow-list-frame { position: relative; min-height: 120px; max-height: 215px; margin-top: 5px; margin-bottom: 10px; padding: 5px; background-color: rgb(25, 34, 41); }
.workflow-area-list { flex-grow: 1; }
.workflow-empty { position: absolute; left: 0; right: 0; top: 45px; font-size: 10px; -unity-text-align: middle-center; color: rgb(112, 132, 143); }
.workflow-area-row { min-height: 43px; flex-direction: row; align-items: center; margin-bottom: 3px; padding-left: 8px; padding-right: 6px; background-color: rgb(32, 42, 50); border-left-width: 2px; border-left-color: rgb(225, 142, 62); }
.workflow-area-row__identity { width: 210px; }
.workflow-area-row__name { font-size: 10px; -unity-font-style: bold; color: rgb(224, 235, 240); }
.workflow-area-row__bounds { margin-top: 2px; font-size: 8px; color: rgb(126, 150, 162); }
.workflow-area-row__destination { width: 155px; font-size: 8px; color: rgb(225, 166, 92); }
.workflow-area-row__floor { flex-grow: 1; font-size: 8px; color: rgb(181, 201, 210); }
.workflow-remove-button { width: 64px; height: 24px; font-size: 8px; color: rgb(231, 181, 164); background-color: rgb(82, 48, 46); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(126, 73, 67); border-right-color: rgb(126, 73, 67); border-top-color: rgb(126, 73, 67); border-bottom-color: rgb(126, 73, 67); }
.workflow-destination-panel { min-height: 70px; flex-direction: row; align-items: center; margin-bottom: 11px; padding: 9px; background-color: rgb(28, 38, 46); border-left-width: 2px; border-left-color: rgb(225, 142, 62); }
.workflow-destination-panel__text { flex-grow: 1; }
.workflow-field-label, .workflow-section-label { font-size: 8px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(113, 154, 173); }
.workflow-section-label { margin-top: 3px; margin-bottom: 4px; padding-bottom: 3px; border-bottom-width: 1px; border-bottom-color: rgb(65, 78, 88); }
.workflow-destination-value { margin-top: 4px; font-size: 11px; -unity-font-style: bold; color: rgb(224, 235, 240); }
.workflow-policy-field { height: 29px; margin-top: 4px; font-size: 9px; }
.workflow-message { height: 20px; margin-top: 5px; font-size: 8px; color: rgb(200, 155, 112); }
