<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="GlobalStatusHud.uss" />
	<ui:VisualElement name="global-status-hud" class="global-status-hud" picking-mode="Ignore">
		<ui:VisualElement class="left-hud" picking-mode="Ignore">
			<ui:VisualElement name="scenario-objective" class="scenario-objective" picking-mode="Ignore">
				<ui:Label text="CURRENT OBJECTIVE" class="scenario-objective__eyebrow" />
				<ui:Label name="scenario-objective-title" text="Objective" class="scenario-objective__title" />
				<ui:Label name="scenario-objective-description" text="Objective description" class="scenario-objective__description" />
				<ui:Label name="scenario-objective-progress" text="0 / 1" class="scenario-objective__progress" />
			</ui:VisualElement>
			<ui:VisualElement name="hud-event-area" class="hud-event-area" picking-mode="Position">
				<ui:VisualElement name="hud-event-list" class="hud-event-list" picking-mode="Ignore" />
			</ui:VisualElement>
			<ui:VisualElement name="economy-summary" class="economy-summary" picking-mode="Position">
				<ui:VisualElement class="status-item">
					<ui:Label text="FUNDS" class="status-label" />
					<ui:Label name="money-value" text="$0" class="status-value status-value--money" />
				</ui:VisualElement>
				<ui:VisualElement class="status-divider" />
				<ui:VisualElement class="status-item">
					<ui:Label text="REPUTATION" class="status-label" />
					<ui:Label name="reputation-value" text="0.0" class="status-value status-value--reputation" />
				</ui:VisualElement>
				<ui:Label text="HISTORY  ›" class="history-hint" />
			</ui:VisualElement>
		</ui:VisualElement>
		<ui:VisualElement class="time-cluster" picking-mode="Position">
			<ui:VisualElement class="date-block">
				<ui:Label text="SIMULATION DATE" class="status-label" />
				<ui:Label name="date-value" text="1년 1월 1째 주" class="date-value" />
			</ui:VisualElement>
			<ui:VisualElement class="time-divider" />
			<ui:Button name="pause-button" text="Ⅱ" class="speed-button" />
			<ui:Button name="normal-speed-button" text="1×" class="speed-button" />
			<ui:Button name="double-speed-button" text="»" class="speed-button" />
			<ui:Label name="speed-value" text="1x" class="speed-value" />
		</ui:VisualElement>
		<ui:VisualElement class="management-cluster" picking-mode="Position">
			<ui:Button name="management-button" text="Management" class="management-button" />
			<ui:VisualElement name="management-menu" class="management-menu">
				<ui:Button name="contract-management-button" text="Contract" class="management-menu__button" />
				<ui:Button name="inventory-management-button" text="Inventory" class="management-menu__button" />
				<ui:Button name="orders-management-button" text="Orders" class="management-menu__button" />
				<ui:Button name="build-management-button" text="Build" class="management-menu__button" />
				<ui:Button name="workflow-management-button" text="Workflow" class="management-menu__button" />
				<ui:Button name="workforce-management-button" text="Workforce" class="management-menu__button" />
				<ui:Button name="company-management-button" text="Company" class="management-menu__button" />
			</ui:VisualElement>
		</ui:VisualElement>
		<ui:VisualElement name="selection-detail-panel" class="selection-detail-panel" picking-mode="Position">
			<ui:VisualElement class="selection-detail-panel__header">
				<ui:Label name="selection-detail-title" text="INVENTORY" class="selection-detail-panel__title" />
				<ui:Label name="selection-detail-summary" text="0 / 0 units" class="selection-detail-panel__summary" />
			</ui:VisualElement>
			<ui:VisualElement name="selection-detail-slider-control" class="selection-detail-panel__slider-control">
				<ui:VisualElement class="selection-detail-panel__slider-header">
					<ui:Label name="selection-detail-slider-label" text="Threshold" class="selection-detail-panel__slider-label" />
					<ui:Label name="selection-detail-slider-value" text="0%" class="selection-detail-panel__slider-value" />
				</ui:VisualElement>
				<ui:Slider name="selection-detail-slider" low-value="0" high-value="100" class="selection-detail-panel__slider" />
			</ui:VisualElement>
			<ui:VisualElement name="selection-detail-toggle-control" class="selection-detail-panel__toggle-control">
				<ui:Toggle name="selection-detail-toggle" text="Policy" class="selection-detail-panel__toggle" />
				<ui:Label name="selection-detail-toggle-description" class="selection-detail-panel__toggle-description" />
			</ui:VisualElement>
			<ui:VisualElement name="selection-detail-editor" class="selection-detail-editor">
				<ui:Label name="selection-detail-editor-message" class="selection-detail-editor__message" />
				<ui:Label name="selection-detail-editor-dropdown-label" text="Workplace" class="selection-detail-editor__label" />
				<ui:DropdownField name="selection-detail-editor-dropdown" class="selection-detail-editor__dropdown" />
				<ui:Label name="selection-detail-editor-toggle-label" text="Assigned Tasks" class="selection-detail-editor__label" />
				<ui:ScrollView name="selection-detail-editor-toggles" class="selection-detail-editor__toggles" />
				<ui:VisualElement name="selection-detail-editor-actions" class="selection-detail-editor__actions">
					<ui:Button name="selection-detail-editor-primary-action" class="selection-detail-editor__button selection-detail-editor__button--primary" />
					<ui:Button name="selection-detail-editor-secondary-action" class="selection-detail-editor__button" />
				</ui:VisualElement>
			</ui:VisualElement>
			<ui:ListView name="selection-detail-list" class="selection-detail-panel__list" virtualization-method="FixedHeight" fixed-item-height="44" />
			<ui:Label name="selection-detail-empty" text="No items stored." class="selection-detail-panel__empty" />
		</ui:VisualElement>
		<ui:VisualElement name="selection-card" class="selection-card" picking-mode="Position">
			<ui:VisualElement class="selection-card__accent" picking-mode="Ignore" />
			<ui:VisualElement class="selection-card__header">
				<ui:Image name="selection-card-icon" class="selection-card__icon" picking-mode="Ignore" />
				<ui:VisualElement class="selection-card__identity">
					<ui:Label name="selection-card-title" text="Selection" class="selection-card__title" />
					<ui:Label name="selection-card-subtitle" text="Target" class="selection-card__subtitle" />
				</ui:VisualElement>
			</ui:VisualElement>
			<ui:VisualElement class="selection-card__divider" picking-mode="Ignore" />
			<ui:VisualElement name="selection-card-info-list" class="selection-card__info-list" />
			<ui:VisualElement name="selection-card-inspector" class="selection-card__inspector">
				<ui:VisualElement name="selection-card-detail-tabs" class="selection-card__detail-tabs" />
				<ui:Label text="OVERVIEW" class="selection-card__section-title" />
				<ui:VisualElement name="selection-card-overview-list" class="selection-card__overview-list" />
				<ui:Label text="ACTIONS" class="selection-card__section-title selection-card__section-title--actions" />
				<ui:VisualElement name="selection-card-context-actions" class="selection-card__context-actions" />
			</ui:VisualElement>
			<ui:VisualElement class="selection-card__actions">
				<ui:Button name="selection-card-focus-button" text="Focus" class="selection-card__button" />
				<ui:Button name="selection-card-details-button" text="Details" class="selection-card__button selection-card__button--primary" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
