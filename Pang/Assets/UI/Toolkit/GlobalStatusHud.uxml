<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Toolkit/GlobalStatusHud.uss?fileID=7433441132597879392&amp;guid=151adf2b625b427a8281fb55f05b1b4d&amp;type=3#GlobalStatusHud"/>
    <ui:VisualElement name="global-status-hud" class="global-status-hud" style="position: absolute; top: auto; bottom: 15px;">
        <ui:VisualElement class="status-cluster">
            <ui:VisualElement class="status-item">
                <ui:Label text="FUNDS" class="status-label"/>
                <ui:Label name="money-value" text="$0" class="status-value status-value--money"/>
            </ui:VisualElement>
            <ui:VisualElement class="status-divider"/>
            <ui:VisualElement class="status-item">
                <ui:Label text="REPUTATION" class="status-label"/>
                <ui:Label name="reputation-value" text="0.0" class="status-value status-value--reputation"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="time-cluster">
            <ui:Label text="SIMULATION" class="status-label time-label"/>
            <ui:Button name="pause-button" text="Ⅱ" tooltip="Pause simulation" class="speed-button"/>
            <ui:Button name="normal-speed-button" text="1×" tooltip="Normal speed" class="speed-button"/>
            <ui:Button name="double-speed-button" text="»" tooltip="Increase speed" class="speed-button"/>
            <ui:Label name="speed-value" text="1x" class="speed-value"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
