<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="EventNoticeContent.uss" />
	<ui:VisualElement name="event-notice-content" class="event-notice">
		<ui:VisualElement name="event-notice-icon" class="event-notice__icon" picking-mode="Ignore" />
		<ui:Label name="event-notice-message" class="event-notice__message" />
		<ui:VisualElement class="event-notice__footer">
			<ui:Button name="event-notice-confirm-button" text="Confirm" class="event-notice__button event-notice__button--primary" />
			<ui:Button name="event-notice-extra-action-button" text="Action" class="event-notice__button" />
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
