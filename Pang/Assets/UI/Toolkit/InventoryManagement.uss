.inventory-management-content {
	flex-grow: 1;
}

.inventory-summary {
	height: 72px;
	flex-direction: row;
	margin-bottom: 10px;
}

.inventory-summary-card {
	width: 25%;
	margin-right: 6px;
	padding-left: 12px;
	padding-top: 9px;
	background-color: rgb(28, 39, 47);
	border-left-width: 2px;
	border-left-color: rgb(67, 137, 160);
}

.inventory-summary-card--last {
	margin-right: 0;
}

.inventory-summary-card__label {
	font-size: 8px;
	-unity-font-style: bold;
	letter-spacing: 1px;
	color: rgb(116, 148, 163);
}

.inventory-summary-card__value {
	margin-top: 5px;
	font-size: 21px;
	-unity-font-style: bold;
	color: rgb(228, 239, 243);
}

.inventory-summary-card__value--warning {
	color: rgb(229, 170, 86);
}

.inventory-summary-card__value--supply {
	color: rgb(96, 207, 171);
}

.inventory-body {
	flex-grow: 1;
	flex-direction: row;
}

.inventory-list-panel {
	position: relative;
	width: 67%;
	padding-right: 10px;
}

.inventory-detail-panel {
	width: 33%;
	padding-left: 12px;
	border-left-width: 1px;
	border-left-color: rgb(58, 73, 83);
}

.inventory-heading {
	font-size: 14px;
	-unity-font-style: bold;
	color: rgb(230, 240, 244);
}

.inventory-caption {
	margin-top: 2px;
	margin-bottom: 7px;
	font-size: 9px;
	color: rgb(123, 148, 160);
}

.inventory-table-header {
	height: 24px;
	flex-direction: row;
	align-items: center;
	padding-left: 9px;
	padding-right: 7px;
	background-color: rgb(23, 32, 39);
	border-bottom-width: 1px;
	border-bottom-color: rgb(58, 73, 83);
}

.inventory-table-header Label {
	font-size: 7px;
	-unity-font-style: bold;
	letter-spacing: 0.5px;
	color: rgb(108, 140, 155);
}

.inventory-table-header__item,
.inventory-row__identity {
	width: 145px;
}

.inventory-table-header__number,
.inventory-row__number {
	width: 58px;
	-unity-text-align: middle-right;
}

.inventory-table-header__number--small,
.inventory-row__number--small {
	width: 43px;
}

.inventory-table-header__incoming,
.inventory-row__incoming {
	width: 78px;
	-unity-text-align: middle-right;
}

.inventory-table-header__status,
.inventory-row__status {
	flex-grow: 1;
	-unity-text-align: middle-right;
}

.inventory-item-list {
	flex-grow: 1;
}

.inventory-empty {
	position: absolute;
	left: 0;
	right: 10px;
	top: 105px;
	font-size: 10px;
	-unity-text-align: middle-center;
	color: rgb(112, 132, 143);
}

.inventory-row {
	height: 45px;
	flex-direction: row;
	align-items: center;
	margin-top: 3px;
	padding-left: 7px;
	padding-right: 7px;
	background-color: rgb(31, 42, 50);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 2px;
	border-top-color: rgb(43, 57, 66);
	border-right-color: rgb(43, 57, 66);
	border-bottom-color: rgb(43, 57, 66);
	border-left-color: rgb(65, 119, 140);
}

.inventory-row:hover,
.inventory-row--selected {
	background-color: rgb(39, 57, 67);
	border-left-color: rgb(74, 186, 218);
}

.inventory-row--warning {
	border-left-color: rgb(214, 141, 62);
}

.inventory-row__name {
	font-size: 10px;
	-unity-font-style: bold;
	color: rgb(224, 235, 240);
}

.inventory-row__id {
	margin-top: 2px;
	font-size: 7px;
	color: rgb(112, 136, 148);
}

.inventory-row__number,
.inventory-row__incoming,
.inventory-row__status {
	font-size: 9px;
	color: rgb(179, 198, 207);
}

.inventory-row__number--available {
	color: rgb(96, 207, 171);
}

.inventory-row__status {
	font-size: 8px;
	color: rgb(112, 180, 205);
}

.inventory-detail-header {
	height: 53px;
	flex-direction: row;
	align-items: center;
	margin-bottom: 7px;
	padding-bottom: 7px;
	border-bottom-width: 1px;
	border-bottom-color: rgb(58, 73, 83);
}

.inventory-detail-header__identity {
	flex-grow: 1;
}

.inventory-detail-name {
	font-size: 16px;
	-unity-font-style: bold;
	color: rgb(230, 240, 244);
}

.inventory-detail-status {
	margin-top: 3px;
	font-size: 9px;
	color: rgb(111, 181, 204);
}

.inventory-link-button {
	width: 88px;
	height: 26px;
	font-size: 9px;
	-unity-font-style: bold;
	color: rgb(224, 238, 243);
	background-color: rgb(31, 89, 108);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgb(65, 151, 177);
	border-right-color: rgb(65, 151, 177);
	border-bottom-color: rgb(65, 151, 177);
	border-left-color: rgb(65, 151, 177);
}

.inventory-detail-scroll {
	flex-grow: 1;
}

.inventory-section-label {
	height: 24px;
	margin-top: 6px;
	padding-top: 7px;
	font-size: 8px;
	-unity-font-style: bold;
	letter-spacing: 1px;
	color: rgb(91, 167, 194);
}

.inventory-metric-row {
	min-height: 27px;
	flex-direction: row;
	align-items: center;
	padding-left: 8px;
	padding-right: 8px;
	margin-bottom: 2px;
	background-color: rgb(29, 39, 47);
}

.inventory-metric-row--accent {
	border-left-width: 2px;
	border-left-color: rgb(70, 181, 145);
}

.inventory-metric-row__label {
	flex-grow: 1;
	font-size: 9px;
	color: rgb(144, 165, 175);
}

.inventory-metric-row__value {
	font-size: 10px;
	-unity-font-style: bold;
	color: rgb(222, 234, 238);
}

.inventory-detail-note {
	margin-top: 4px;
	padding-left: 8px;
	padding-right: 8px;
	padding-top: 6px;
	padding-bottom: 6px;
	white-space: normal;
	font-size: 8px;
	color: rgb(127, 151, 163);
	background-color: rgb(24, 34, 41);
}

.inventory-detail-note--stages {
	color: rgb(157, 192, 205);
}

.inventory-boundary-note {
	margin-top: 8px;
	white-space: normal;
	font-size: 8px;
	color: rgb(146, 116, 91);
}
