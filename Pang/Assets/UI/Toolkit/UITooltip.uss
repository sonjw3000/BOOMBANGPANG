.ui-tooltip-layer {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.ui-tooltip {
	position: absolute;
	display: none;
	visibility: hidden;
	width: 340px;
	max-width: 340px;
	padding: 12px 14px;
	background-color: rgba(16, 27, 34, 0.98);
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-top-color: rgb(69, 103, 119);
	border-right-color: rgb(69, 103, 119);
	border-bottom-color: rgb(69, 103, 119);
	border-left-color: rgb(69, 103, 119);
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
}

.ui-tooltip__title {
	color: rgb(234, 244, 248);
	font-size: 15px;
	-unity-font-style: bold;
	white-space: normal;
}

.ui-tooltip__description {
	margin-top: 5px;
	color: rgb(184, 205, 214);
	font-size: 13px;
	white-space: normal;
}

.ui-tooltip__requirement {
	display: none;
	margin-top: 9px;
	padding-top: 8px;
	border-top-width: 1px;
	border-top-color: rgb(72, 91, 101);
}

.ui-tooltip__requirement-label {
	color: rgb(239, 190, 105);
	font-size: 12px;
	-unity-font-style: bold;
	white-space: normal;
}

.ui-tooltip--locked {
	border-top-color: rgb(159, 122, 67);
	border-right-color: rgb(159, 122, 67);
	border-bottom-color: rgb(159, 122, 67);
	border-left-color: rgb(159, 122, 67);
}
