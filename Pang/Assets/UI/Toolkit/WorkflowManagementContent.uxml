<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="WorkflowManagement.uss" />
	<ui:VisualElement class="workflow-content">
		<ui:VisualElement class="workflow-tabs">
			<ui:VisualElement class="workflow-tabs__separator" picking-mode="Ignore" />
			<ui:Button name="workflow-monitor-button" text="Monitor" class="workflow-tab-button" />
			<ui:Button name="workflow-inbound-button" text="Inbound" class="workflow-tab-button" />
			<ui:Button name="workflow-outbound-button" text="Outbound" class="workflow-tab-button" />
			<ui:VisualElement name="workflow-policy-button-control" class="workflow-tab-control">
				<ui:Button name="workflow-policy-button" text="Policy" class="workflow-tab-button" />
			</ui:VisualElement>
		</ui:VisualElement>
		<ui:ScrollView name="workflow-monitor-tab" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Auto" class="workflow-tab workflow-monitor">
			<ui:Label text="Logistics Work Monitor" class="workflow-heading" />
			<ui:Label text="Demand is owner-reported workload, not a projected Task count. Task states count generated worker tasks; Blocked is part of Active." class="workflow-caption" />
			<ui:VisualElement class="workflow-monitor-scope">
				<ui:Label text="BUILDING SCOPE" class="workflow-monitor-scope__label" />
				<ui:DropdownField name="workflow-monitor-building-scope" class="workflow-monitor-scope__field" />
			</ui:VisualElement>
			<ui:VisualElement class="workflow-monitor-table">
				<ui:VisualElement class="workflow-monitor-row workflow-monitor-row--header">
					<ui:Label text="WORK" class="workflow-monitor-name workflow-monitor-header" />
					<ui:Label name="workflow-monitor-demand-header" text="DEMAND" class="workflow-monitor-value workflow-monitor-header" />
					<ui:Label name="workflow-monitor-items-header" text="ITEMS" class="workflow-monitor-value workflow-monitor-header" />
					<ui:Label name="workflow-monitor-waiting-header" text="WAITING" class="workflow-monitor-value workflow-monitor-header" />
					<ui:Label name="workflow-monitor-ready-header" text="READY" class="workflow-monitor-value workflow-monitor-header" />
					<ui:Label name="workflow-monitor-returned-header" text="RETURNED" class="workflow-monitor-value workflow-monitor-header" />
					<ui:Label name="workflow-monitor-active-header" text="ACTIVE" class="workflow-monitor-value workflow-monitor-header" />
					<ui:Label name="workflow-monitor-blocked-header" text="BLOCKED" class="workflow-monitor-value workflow-monitor-header" />
				</ui:VisualElement>
				<ui:VisualElement class="workflow-monitor-row">
					<ui:Label text="Picking" class="workflow-monitor-name" />
					<ui:Label name="workflow-monitor-picking-demand" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-picking-items" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-picking-waiting" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-picking-ready" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-picking-returned" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-picking-active" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-picking-blocked" text="0" class="workflow-monitor-value" />
				</ui:VisualElement>
				<ui:VisualElement class="workflow-monitor-row">
					<ui:Label text="Storing" class="workflow-monitor-name" />
					<ui:Label name="workflow-monitor-storing-demand" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-storing-items" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-storing-waiting" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-storing-ready" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-storing-returned" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-storing-active" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-storing-blocked" text="0" class="workflow-monitor-value" />
				</ui:VisualElement>
				<ui:VisualElement class="workflow-monitor-row workflow-monitor-row--packing">
					<ui:Label text="Packing · Input" class="workflow-monitor-name workflow-monitor-name--child" />
					<ui:Label name="workflow-monitor-packing-input-demand" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-input-items" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-input-waiting" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-input-ready" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-input-returned" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-input-active" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-input-blocked" text="0" class="workflow-monitor-value" />
				</ui:VisualElement>
				<ui:VisualElement class="workflow-monitor-row workflow-monitor-row--packing">
					<ui:Label text="Packing" class="workflow-monitor-name" />
					<ui:Label name="workflow-monitor-packing-demand" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-items" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-waiting" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-ready" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-returned" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-active" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-blocked" text="0" class="workflow-monitor-value" />
				</ui:VisualElement>
				<ui:VisualElement class="workflow-monitor-row workflow-monitor-row--packing">
					<ui:Label text="Packing · Output" class="workflow-monitor-name workflow-monitor-name--child" />
					<ui:Label name="workflow-monitor-packing-output-demand" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-output-items" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-output-waiting" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-output-ready" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-output-returned" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-output-active" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-packing-output-blocked" text="0" class="workflow-monitor-value" />
				</ui:VisualElement>
				<ui:VisualElement class="workflow-monitor-row">
					<ui:Label text="Capsule Relocate" class="workflow-monitor-name" />
					<ui:Label name="workflow-monitor-capsule-relocate-demand" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-capsule-relocate-items" text="—" class="workflow-monitor-value workflow-monitor-value--na" />
					<ui:Label name="workflow-monitor-capsule-relocate-waiting" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-capsule-relocate-ready" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-capsule-relocate-returned" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-capsule-relocate-active" text="0" class="workflow-monitor-value" />
					<ui:Label name="workflow-monitor-capsule-relocate-blocked" text="0" class="workflow-monitor-value" />
				</ui:VisualElement>
			</ui:VisualElement>
			<ui:VisualElement class="workflow-monitor-legend">
				<ui:Label text="DEMAND  |  TASKS: WAITING = READY + RETURNED  |  ACTIVE" class="workflow-monitor-legend__flow" />
				<ui:Label text="Counts are independent; do not add Demand to Task states." class="workflow-monitor-legend__note" />
			</ui:VisualElement>
		</ui:ScrollView>
		<ui:ScrollView name="workflow-inbound-tab" class="workflow-tab">
			<ui:VisualElement class="workflow-section-toolbar">
				<ui:VisualElement class="workflow-section-toolbar__text">
					<ui:Label text="Landing Areas" class="workflow-heading" />
					<ui:Label text="Create and remove global rocket landing areas." class="workflow-caption" />
				</ui:VisualElement>
				<ui:Button name="workflow-add-landing-area-button" text="Add Area" class="workflow-action-button" />
			</ui:VisualElement>
			<ui:VisualElement class="workflow-list-frame">
				<ui:ScrollView name="workflow-landing-area-list" class="workflow-area-list" />
				<ui:Label name="workflow-landing-area-empty" text="No Landing Areas configured." class="workflow-empty" />
			</ui:VisualElement>
			<ui:VisualElement class="workflow-destination-panel">
				<ui:VisualElement class="workflow-destination-panel__text">
					<ui:Label text="LANDING DESTINATION" class="workflow-field-label" />
					<ui:Label name="workflow-unloading-destination" text="Automatic" class="workflow-destination-value" />
					<ui:Label text="Link mode: select a Landing Area, then select its destination Building." class="workflow-caption" />
				</ui:VisualElement>
				<ui:Button name="workflow-link-landing-area-button" text="Link" class="workflow-action-button" />
			</ui:VisualElement>
		</ui:ScrollView>
		<ui:VisualElement name="workflow-outbound-tab" class="workflow-tab">
			<ui:Label text="Outbound Workflow" class="workflow-heading" />
			<ui:Label text="Choose which building receives outbound loading for launch." class="workflow-caption" />
			<ui:VisualElement class="workflow-destination-panel">
				<ui:VisualElement class="workflow-destination-panel__text">
					<ui:Label text="LOADING DESTINATION" class="workflow-field-label" />
					<ui:Label name="workflow-loading-destination" text="Automatic" class="workflow-destination-value" />
				</ui:VisualElement>
				<ui:Button name="workflow-link-outbound-destination-button" text="Link" class="workflow-action-button" />
			</ui:VisualElement>
		</ui:VisualElement>
		<ui:ScrollView name="workflow-policy-tab" class="workflow-tab">
			<ui:Label text="Workflow Policy" class="workflow-heading" />
			<ui:Label text="Choose how workers collect, route, and place cargo." class="workflow-caption" />
			<ui:Label text="STORING POLICY" class="workflow-section-label" />
			<ui:VisualElement name="workflow-collecting-policy-control">
				<ui:DropdownField name="workflow-collecting-policy" label="Capsule collecting" class="workflow-policy-field" />
			</ui:VisualElement>
			<ui:VisualElement name="workflow-placing-policy-control">
				<ui:DropdownField name="workflow-placing-policy" label="Shelf placing" class="workflow-policy-field" />
			</ui:VisualElement>
			<ui:VisualElement name="workflow-storing-box-fill-control" class="workflow-slider-control">
				<ui:VisualElement class="workflow-slider-header">
					<ui:Label text="Storing box fill limit" class="workflow-slider-label" />
					<ui:Label name="workflow-storing-box-fill-value" text="80%" class="workflow-slider-value" />
				</ui:VisualElement>
				<ui:Slider name="workflow-storing-box-fill" low-value="1" high-value="100" value="80" class="workflow-slider" />
			</ui:VisualElement>
			<ui:Label text="INBOUND QUALITY CONTROL" class="workflow-section-label" />
			<ui:VisualElement name="workflow-inbound-qc-control" class="workflow-quality-control">
				<ui:Toggle name="workflow-inbound-qc-enabled" label="Inspect during Labeling" class="workflow-quality-toggle" />
				<ui:VisualElement class="workflow-slider-header">
					<ui:Label text="Minimum freshness" class="workflow-slider-label" />
					<ui:Label name="workflow-inbound-qc-freshness-value" text="50%" class="workflow-slider-value" />
				</ui:VisualElement>
				<ui:Slider name="workflow-inbound-qc-freshness" low-value="0" high-value="100" value="50" class="workflow-slider" />
				<ui:VisualElement class="workflow-slider-header">
					<ui:Label text="Maximum damage" class="workflow-slider-label" />
					<ui:Label name="workflow-inbound-qc-damage-value" text="50%" class="workflow-slider-value" />
				</ui:VisualElement>
				<ui:Slider name="workflow-inbound-qc-damage" low-value="0" high-value="100" value="50" class="workflow-slider" />
			</ui:VisualElement>
			<ui:Label text="PICKING POLICY" class="workflow-section-label" />
			<ui:VisualElement name="workflow-picking-policy-control">
				<ui:DropdownField name="workflow-picking-policy" label="Picking method" class="workflow-policy-field" />
			</ui:VisualElement>
			<ui:VisualElement name="workflow-picking-collecting-policy-control">
				<ui:DropdownField name="workflow-picking-collecting-policy" label="Guided source priority" class="workflow-policy-field" />
			</ui:VisualElement>
			<ui:VisualElement name="workflow-picking-box-fill-control" class="workflow-slider-control">
				<ui:VisualElement class="workflow-slider-header">
					<ui:Label text="Picking box fill limit" class="workflow-slider-label" />
					<ui:Label name="workflow-picking-box-fill-value" text="80%" class="workflow-slider-value" />
				</ui:VisualElement>
				<ui:Slider name="workflow-picking-box-fill" low-value="1" high-value="100" value="80" class="workflow-slider" />
			</ui:VisualElement>
			<ui:Label text="OUTBOUND QUALITY CONTROL" class="workflow-section-label" />
			<ui:VisualElement name="workflow-outbound-qc-control" class="workflow-quality-control">
				<ui:Toggle name="workflow-outbound-qc-enabled" label="Inspect during LaunchSort" class="workflow-quality-toggle" />
				<ui:VisualElement class="workflow-slider-header">
					<ui:Label text="Minimum freshness" class="workflow-slider-label" />
					<ui:Label name="workflow-outbound-qc-freshness-value" text="50%" class="workflow-slider-value" />
				</ui:VisualElement>
				<ui:Slider name="workflow-outbound-qc-freshness" low-value="0" high-value="100" value="50" class="workflow-slider" />
				<ui:VisualElement class="workflow-slider-header">
					<ui:Label text="Maximum damage" class="workflow-slider-label" />
					<ui:Label name="workflow-outbound-qc-damage-value" text="50%" class="workflow-slider-value" />
				</ui:VisualElement>
				<ui:Slider name="workflow-outbound-qc-damage" low-value="0" high-value="100" value="50" class="workflow-slider" />
			</ui:VisualElement>
			<ui:Label text="Inventory-guided picking requires Inventory Digitization research." class="workflow-caption" />
		</ui:ScrollView>
		<ui:Label name="workflow-message" text="" class="workflow-message" />
	</ui:VisualElement>
</ui:UXML>
